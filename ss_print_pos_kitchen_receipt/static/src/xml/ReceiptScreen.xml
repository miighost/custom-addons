<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

<t t-name="ss_print_pos_kitchen_receipt.ReceiptScreen" t-inherit="point_of_sale.ReceiptScreen" t-inherit-mode="extension">
    <!-- Add kitchen receipt button in the same flex row as other print buttons (first direct child d-flex.gap-1 of receipt-options) -->
    <xpath expr="//div[hasclass('receipt-options')]/div[hasclass('d-flex') and hasclass('gap-1')]" position="inside">
        <button class="button print btn btn-lg btn-secondary w-100 py-3" t-on-click="() => this.printKitchenReceipt()">
            <i class="fa fa-cutlery me-1"/> Print Kitchen Receipt
        </button>
        <!-- Reprint of the customer bill on the USB receipt printer. The bill
             prints by itself when this screen opens; this is the retry. -->
        <button class="button print btn btn-lg btn-secondary w-100 py-3" t-on-click="() => this.printCustomerBillAgain()">
            <i class="fa fa-file-text-o me-1"/> Print Bill
        </button>
    </xpath>

    <!-- Keep existing buttons for backward compatibility (kitchen change printing) -->
    <xpath expr="//div[hasclass('receipt-options')]" position="inside">
        <div class="d-flex gap-1">
            <t t-if="hasKitchenChanges() and !kitchenPrintState.printedChanges">
                 <div class="button print btn btn-lg btn-secondary w-100 py-3 d-flex align-items-center justify-content-center" t-on-click="printReceiptAndKitchen">
                    <i class="fa fa-print me-1"></i> Print Receipt and Kitchen
                </div>
                <div class="button print btn btn-lg btn-secondary w-100 py-3 d-flex align-items-center justify-content-center" t-on-click="printKitchenChanges">
                    <i class="fa fa-print me-1"></i> Print Kitchen Changes
                </div>
            </t>
        </div>
    </xpath>

</t>

</templates>
