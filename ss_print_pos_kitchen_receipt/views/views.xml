<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         Network ESC/POS printers
         ============================================================ -->
    <record id="view_ss_escpos_printer_list" model="ir.ui.view">
        <field name="name">ss.escpos.printer.list</field>
        <field name="model">ss.escpos.printer</field>
        <field name="arch" type="xml">
            <list string="Network Printers">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="ip"/>
                <field name="port"/>
                <field name="transport"/>
                <field name="paper_width"/>
                <field name="product_category_ids" widget="many2many_tags"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'online'"
                       decoration-danger="status == 'offline'"
                       decoration-muted="status == 'unknown'"/>
                <field name="last_seen" optional="hide"/>
                <field name="last_print" optional="show"/>
                <field name="last_error" optional="hide"/>
                <button name="action_probe" type="object" string="Probe"
                        icon="fa-plug" class="btn-link"
                        title="Check this printer answers on its port"/>
                <button name="action_test_print" type="object" string="Test"
                        icon="fa-print" class="btn-link"
                        title="Send a sample ticket"
                        invisible="transport != 'server_socket'"/>
                <field name="transport" column_invisible="1"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_ss_escpos_printer_form" model="ir.ui.view">
        <field name="name">ss.escpos.printer.form</field>
        <field name="model">ss.escpos.printer</field>
        <field name="arch" type="xml">
            <form string="Network Printer">
                <header>
                    <button name="action_probe" type="object" string="Probe port"
                            class="btn-secondary"
                            help="Open a TCP connection and close it again, without printing."/>
                    <button name="action_test_print" type="object" string="Test print"
                            class="btn-primary"
                            invisible="transport != 'server_socket'"/>
                    <button name="action_open_scan" type="object"
                            string="Scan network" class="btn-secondary"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="unknown,online,offline"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Kitchen"/></h1>
                    </div>
                    <group>
                        <group string="Network">
                            <field name="ip" placeholder="192.168.1.50"/>
                            <field name="port"/>
                            <field name="transport"/>
                            <field name="agent_url"
                                   invisible="transport != 'browser_agent'"
                                   required="transport == 'browser_agent'"/>
                        </group>
                        <group string="Paper">
                            <field name="paper_width"/>
                            <field name="codepage"/>
                            <field name="station_label" placeholder="KITCHEN"/>
                        </group>
                    </group>
                    <group string="Routing">
                        <field name="pos_config_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                        <field name="product_category_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <group string="Diagnostics" col="4">
                        <field name="last_seen" readonly="1"/>
                        <field name="last_print" readonly="1"/>
                        <field name="last_error" readonly="1" colspan="4"
                               invisible="not last_error"/>
                    </group>
                    <div class="text-muted">
                        Leave <b>POS categories</b> empty to send every order line to this
                        printer. Set categories to split food and drinks across stations.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ss_escpos_printer_search" model="ir.ui.view">
        <field name="name">ss.escpos.printer.search</field>
        <field name="model">ss.escpos.printer</field>
        <field name="arch" type="xml">
            <search string="Network Printers">
                <field name="name"/>
                <field name="ip"/>
                <filter name="filter_online" string="Online"
                        domain="[('status','=','online')]"/>
                <filter name="filter_offline" string="Unreachable"
                        domain="[('status','=','offline')]"/>
                <separator/>
                <filter name="filter_inactive" string="Archived"
                        domain="[('active','=',False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_transport" string="Transport"
                            context="{'group_by': 'transport'}"/>
                    <filter name="group_status" string="Status"
                            context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ss_escpos_printer" model="ir.actions.act_window">
        <field name="name">Network Printers</field>
        <field name="res_model">ss.escpos.printer</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a network printer</p>
            <p>
                Register each thermal printer by its LAN address. Generic ESC/POS
                units normally listen on port 9100.
            </p>
            <p>
                Not sure of the addresses? Use
                <b>Point of Sale &#8594; Configuration &#8594; Scan for Printers</b>
                to sweep the network, test each device, and add the ones that print.
            </p>
        </field>
    </record>

    <menuitem id="menu_ss_escpos_printer"
              name="Network Printers"
              parent="point_of_sale.menu_point_config"
              action="action_ss_escpos_printer"
              sequence="90"/>

</odoo>
