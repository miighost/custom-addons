<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      Exposes the kitchen_print / kitchen_print_auto fields declared in
      models/pos.py. Without a view they exist in the database but are
      unreachable from the interface, which is why kitchen_print_auto never
      fired.

      Deliberately NOT an inherited view. Injecting into
      point_of_sale.pos_config_view_form means betting on that form's internal
      structure, which changes between versions and cannot be checked from
      here. A standalone list owns its own markup and cannot be broken by
      Odoo rearranging its form.
    -->
    <record id="view_pos_config_kitchen_print_list" model="ir.ui.view">
        <field name="name">pos.config.kitchen.print.list</field>
        <field name="model">pos.config</field>
        <field name="arch" type="xml">
            <list string="Kitchen Printing" editable="bottom"
                  create="false" delete="false">
                <field name="name" readonly="1"/>
                <field name="kitchen_print" string="Show Print KOT button"/>
                <field name="kitchen_print_auto" string="Automatic printing"/>
                <field name="kitchen_print_trigger"
                       readonly="not kitchen_print_auto"/>
            </list>
        </field>
    </record>

    <record id="action_pos_config_kitchen_print" model="ir.actions.act_window">
        <field name="name">Kitchen Printing</field>
        <field name="res_model">pos.config</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_pos_config_kitchen_print_list"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No Point of Sale configured yet</p>
            <p>
                Toggle kitchen receipt printing per POS here. The printers themselves
                live under Configuration &#8594; Network Printers.
            </p>
        </field>
    </record>

    <menuitem id="menu_pos_config_kitchen_print"
              name="Kitchen Printing"
              parent="point_of_sale.menu_point_config_product"
              action="action_pos_config_kitchen_print"
              sequence="89"/>
</odoo>
