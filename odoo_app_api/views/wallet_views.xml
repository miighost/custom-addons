<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- No custom views here on purpose. Each action opens Odoo's own
         standard loyalty screens, filtered to eWallet programs. Anything
         Odoo changes in a future version, we inherit for free. -->

    <record id="action_jph_wallets" model="ir.actions.act_window">
        <field name="name">JPH Wallets</field>
        <field name="res_model">loyalty.card</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('program_type', '=', 'ewallet')]</field>
        <!-- A wallet is never created by hand: a card with no program breaks
             Odoo's own creation hook. Wallets come from a top-up or from the
             program's Generate button. -->
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No wallets yet</p>
            <p>Wallets are not created by hand. Either use <b>Top Up Wallet</b>
               to credit a customer, or open the program under
               Configuration &gt; Wallet Programs and use its <b>Generate</b>
               button to issue wallets to a list of customers at once.</p>
        </field>
    </record>

    <record id="action_wallet_history" model="ir.actions.act_window">
        <field name="name">Wallet Transactions</field>
        <field name="res_model">loyalty.history</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('card_id.program_type', '=', 'ewallet')]</field>
        <field name="context">{'create': False, 'edit': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No wallet movements yet</p>
            <p>Every top-up and every spend writes a line here. This is the
               ledger to reconcile against your wallet liability account.</p>
        </field>
    </record>

    <record id="action_wallet_programs" model="ir.actions.act_window">
        <field name="name">Wallet Programs</field>
        <field name="res_model">loyalty.program</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('program_type', '=', 'ewallet')]</field>
        <field name="context">{'default_program_type': 'ewallet'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your JPH Wallet program</p>
            <p>Add an eWallet program, list your top-up products on it, and
               customers can start loading credit.</p>
        </field>
    </record>

    <!-- Top Up appears in the Actions menu of the standard wallet list
         and form, so no core view needs to be modified. -->
    <record id="action_server_wallet_topup" model="ir.actions.server">
        <field name="name">Top Up Wallet</field>
        <field name="model_id" ref="loyalty.model_loyalty_card"/>
        <field name="binding_model_id" ref="loyalty.model_loyalty_card"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
if records:
    action = records[0].action_open_topup_wizard()
        </field>
    </record>

</odoo>
