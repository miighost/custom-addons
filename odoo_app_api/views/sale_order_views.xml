<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_app" model="ir.ui.view">
        <field name="name">sale.order.form.app.api</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <field name="client_order_ref" position="after">
                <field name="is_app_order" invisible="1"/>
                <field name="app_payment_method" invisible="not is_app_order"/>
                <field name="app_payment_reference" invisible="not app_payment_reference"/>
            </field>
        </field>
    </record>
</odoo>
