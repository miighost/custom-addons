<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================ ORDERS ============================ -->

    <record id="action_app_orders" model="ir.actions.act_window">
        <field name="name">App Orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_app_order', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No orders from the app yet</p>
            <p>Orders placed by customers in the mobile app land here, and in
               Sales like any other order. Clear the Quotations filter to see
               confirmed ones too.</p>
        </field>
    </record>

    <!-- ========================== CUSTOMERS =========================== -->

    <record id="action_app_customers" model="ir.actions.act_window">
        <field name="name">App Customers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('firebase_uid', '!=', False)]</field>
        <field name="context">{'default_customer_rank': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nobody has signed up yet</p>
            <p>A contact appears here the first time that person signs in to
               the app. Their membership code is generated at the same moment.</p>
        </field>
    </record>

    <!-- =========================== WALLETS ============================ -->

    <!-- ========================== INVOICES ============================ -->
    <record id="action_app_invoices" model="ir.actions.act_window">
        <field name="name">Customer Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', '=', 'out_invoice'), ('partner_id.firebase_uid', '!=', False)]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No invoices for app customers</p>
            <p>Invoices addressed to a customer who uses the app. They can see
               these in the app and clear them from their eWallet or by mobile
               money.</p>
        </field>
    </record>

    <!-- ========================== SETTINGS ============================ -->
    <record id="action_app_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'odoo_app_api'}</field>
    </record>

    <!-- ============================ MENUS ============================= -->
    <menuitem id="menu_app_root" name="Mobile App" sequence="82"
              action="action_app_dashboard"
              web_icon="odoo_app_api,static/description/icon.png"/>

    <menuitem id="menu_app_dashboard" name="Dashboard"
              parent="menu_app_root" action="action_app_dashboard" sequence="5"/>

    <menuitem id="menu_app_operations" name="Operations"
              parent="menu_app_root" sequence="10"/>

    <menuitem id="menu_app_orders" name="Orders"
              parent="menu_app_operations" action="action_app_orders" sequence="10"/>
    <menuitem id="menu_app_invoices" name="Invoices"
              parent="menu_app_operations" action="action_app_invoices" sequence="20"/>

    <menuitem id="menu_jph_wallet_root" name="JPH Wallet"
              parent="menu_app_root" sequence="15"/>
    <menuitem id="menu_jph_wallets" name="Wallets"
              parent="menu_jph_wallet_root" action="action_jph_wallets" sequence="10"/>
    <menuitem id="menu_jph_wallet_topup" name="Top Up Wallet"
              parent="menu_jph_wallet_root" action="action_app_wallet_topup" sequence="20"/>
    <menuitem id="menu_jph_wallet_history" name="Transactions"
              parent="menu_jph_wallet_root" action="action_wallet_history" sequence="30"/>

    <menuitem id="menu_app_customers_root" name="Customers"
              parent="menu_app_root" sequence="20"/>
    <menuitem id="menu_app_customers" name="App Customers"
              parent="menu_app_customers_root" action="action_app_customers" sequence="10"/>

    <menuitem id="menu_app_configuration" name="Configuration"
              parent="menu_app_root" sequence="90"
              groups="base.group_system"/>
    <menuitem id="menu_app_wallet_programs" name="Wallet Programs"
              parent="menu_app_configuration" action="action_wallet_programs" sequence="5"/>
    <menuitem id="menu_app_settings" name="Settings"
              parent="menu_app_configuration" action="action_app_settings" sequence="10"/>

</odoo>
