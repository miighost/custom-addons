<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_app" model="ir.ui.view">
        <field name="name">product.template.form.app.api</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="sale_ok" position="after">
                <field name="available_in_app"/>
            </field>
        </field>
    </record>

    <record id="view_product_template_search_app" model="ir.ui.view">
        <field name="name">product.template.search.app.api</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <filter name="filter_to_sell" position="after">
                <filter string="In Mobile App" name="filter_available_in_app"
                        domain="[('available_in_app', '=', True)]"/>
            </filter>
        </field>
    </record>
</odoo>
