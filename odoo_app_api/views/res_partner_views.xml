<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_app" model="ir.ui.view">
        <field name="name">res.partner.form.app.api</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='internal_notes']" position="before">
                <page string="Mobile App" name="app_api">
                    <group>
                        <field name="firebase_uid"
                               placeholder="Paste the Firebase UID to link this contact"/>
                        <field name="barcode" string="Membership Code"
                               placeholder="Generated on first app sign-in"/>
                        <field name="app_signup_date" readonly="1"/>
                        <field name="is_app_user" invisible="1"/>
                    </group>
                    <div class="text-muted">
                        Find the UID in the Firebase console under
                        Authentication &gt; Users &gt; the "User UID" column.
                        Leave empty for contacts that do not use the app.
                        A contact whose email matches a verified app account is
                        linked automatically on that customer's first sign-in.
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_res_partner_filter_app" model="ir.ui.view">
        <field name="name">res.partner.search.app.api</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <filter name="type_company" position="after">
                <separator/>
                <filter string="App Users" name="app_users"
                        domain="[('firebase_uid', '!=', False)]"/>
            </filter>
        </field>
    </record>
</odoo>
