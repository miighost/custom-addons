<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t t-name="itp_pos_qr_scan.QRScanPopup">
        <div class="modal-dialog">
            <div class="popup popup-qr_scan">
                <div id="preview-container">
                    <video
                        t-ref="preview"
                        class="video_preview"
                        autoplay="true"
                        playsinline="true"
                        webkit-playsinline="true"
                        muted="true"
                        t-on-click="onClickCancel"
                    />

                    <!-- Camera Type Badge (Front / Back Camera Indicator) -->
                    <div class="camera-status-badge">
                        <span class="badge bg-dark text-white shadow-sm p-2 fs-6 border border-secondary" t-on-click="toggleCameraFacing">
                            <t t-esc="this.activeCameraLabel"/>
                            <t t-if="state.videoDevices &amp;&amp; state.videoDevices.length > 1">
                                <i class="fa fa-sync ms-2 text-warning" title="Tap to switch camera"/>
                            </t>
                        </span>
                    </div>

                    <!-- Centered Target Scanning Reticle Overlay -->
                    <div t-attf-class="scan-target-reticle #{state.scannedSuccess ? 'scan-success-flash' : ''}">
                        <div class="target-corner top-left"/>
                        <div class="target-corner top-right"/>
                        <div class="target-corner bottom-left"/>
                        <div class="target-corner bottom-right"/>
                        <div class="laser-line"/>
                    </div>

                    <input type="file" t-ref="fileInput" accept="image/*" capture="environment" style="display: none;" t-on-change="onFileSelected"/>

                    <t t-if="state.permissionState === 'denied' or state.permissionState === 'error'">
                        <div class="permission-error-overlay">
                            <i class="fa fa-camera fa-3x mb-3 text-warning"/>
                            <h4 class="text-white fw-bold mb-2">Camera Access Required</h4>
                            <p class="text-light mb-4" style="max-width: 340px; font-size: 14px;" t-esc="state.permissionError || 'Please allow camera access in your browser to scan barcodes.'" />
                            <div class="d-flex flex-column gap-2 w-100 justify-content-center" style="max-width: 340px;">
                                <button class="btn btn-primary btn-lg w-100 py-3 fw-bold" t-on-click="requestCameraPermission">
                                    <i class="fa fa-refresh me-2"/> Allow / Retry Camera
                                </button>
                                <button class="btn btn-warning btn-lg w-100 py-3 fw-bold text-dark" t-on-click="triggerFileInput">
                                    <i class="fa fa-camera-retro me-2"/> Take Photo / Upload QR Image
                                </button>
                            </div>
                            <button class="btn btn-link text-white-50 mt-3 text-decoration-none" t-on-click="onClickCancel">
                                <i class="fa fa-times me-1"/> Close
                            </button>
                        </div>
                    </t>
                </div>

                <div class="transparent_sidebar" t-if="state.videoDevices &amp;&amp; state.videoDevices.length > 1">
                    <div class="title">
                        <p class="mb-0">Switch Camera</p>
                    </div>
                    <div class="body mt-2">
                        <t t-foreach="state.videoDevices" t-as="device" t-key="device.deviceId">
                            <button
                                t-attf-class="btn btn-sm me-1 mb-1 #{state.active_camera === device.deviceId ? 'btn-primary' : 'btn-outline-secondary'}"
                                t-esc="device.label || ('Camera ' + (device_index + 1))"
                                t-on-click="() => this.onClickCameraButton(device.deviceId)"
                            />
                        </t>
                    </div>
                </div>

                <div class="note">
                    <p class="mb-0">Center barcode inside target box | Tap video to close</p>
                </div>
            </div>
            <canvas
                t-ref="canvas"
                id="qr-canvas"
                width="800"
                height="600"
                style="width: 800px; height: 600px; display: none;"
            />
        </div>
    </t>
</templates>
