<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Record rule for viewing created records of logged user -->
    <record id="venue_booking_rule_space_user" model="ir.rule">
        <field name="name">View Own Docs</field>
        <field ref="model_venue_booking" name="model_id"/>
        <field name="domain_force">['|', ('partner_id', '=', user.partner_id.id), ('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('venue_booking_management.venue_booking_management_group_venue_user'))]"/>
    </record>

    <!-- Record rule for viewing all records for managers -->
    <record id="venue_booking_rule_space_manager" model="ir.rule">
        <field name="name">View All Docs</field>
        <field ref="model_venue_booking" name="model_id"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('venue_booking_management.venue_booking_management_group_venue_manager'))]"/>
    </record>

    <!-- Record rule for viewing records for portal user -->
    <record id="venue_booking_rule_portal" model="ir.rule">
        <field name="name">Portal Personal Venue Bookings</field>
        <field name="model_id" ref="model_venue_booking"/>
        <field name="domain_force">[('partner_id', 'child_of', [user.partner_id.commercial_partner_id.id])]</field>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
    </record>
</odoo>
