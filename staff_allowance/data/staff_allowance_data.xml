<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="allowance_category_coffee" model="staff.allowance.category">
            <field name="name">Coffee</field>
            <field name="code">coffee</field>
            <field name="daily_limit">10</field>
            <field name="count_mode">qty</field>
            <field name="applies_to">employee</field>
            <field name="fallback">default_limit</field>
            <field name="overdraft_policy">block</field>
            <field name="sequence">10</field>
            <field name="color">1</field>
        </record>

        <record id="allowance_category_snack" model="staff.allowance.category">
            <field name="name">Snacks</field>
            <field name="code">snack</field>
            <field name="daily_limit">5</field>
            <field name="count_mode">qty</field>
            <field name="applies_to">employee</field>
            <field name="fallback">unlimited</field>
            <field name="overdraft_policy">approval</field>
            <field name="overdraft_limit">2</field>
            <field name="sequence">20</field>
            <field name="color">3</field>
        </record>

        <record id="allowance_plan_staff" model="staff.allowance.plan">
            <field name="name">Staff</field>
            <field name="code">staff</field>
            <field name="sequence">10</field>
        </record>

        <record id="allowance_plan_staff_coffee" model="staff.allowance.plan.line">
            <field name="plan_id" ref="allowance_plan_staff"/>
            <field name="category_id" ref="allowance_category_coffee"/>
            <field name="daily_limit">10</field>
        </record>

        <record id="allowance_plan_staff_snack" model="staff.allowance.plan.line">
            <field name="plan_id" ref="allowance_plan_staff"/>
            <field name="category_id" ref="allowance_category_snack"/>
            <field name="daily_limit">5</field>
        </record>

        <record id="allowance_plan_manager" model="staff.allowance.plan">
            <field name="name">Manager</field>
            <field name="code">manager</field>
            <field name="sequence">20</field>
        </record>

        <record id="allowance_plan_manager_coffee" model="staff.allowance.plan.line">
            <field name="plan_id" ref="allowance_plan_manager"/>
            <field name="category_id" ref="allowance_category_coffee"/>
            <field name="daily_limit">15</field>
        </record>

        <record id="allowance_plan_manager_snack" model="staff.allowance.plan.line">
            <field name="plan_id" ref="allowance_plan_manager"/>
            <field name="category_id" ref="allowance_category_snack"/>
            <field name="daily_limit">10</field>
        </record>

    </data>
</odoo>
