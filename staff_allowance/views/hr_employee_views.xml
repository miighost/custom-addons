<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_form_allowance" model="ir.ui.view">
        <field name="name">hr.employee.form.allowance</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_allowance_orders" type="object"
                        class="oe_stat_button" icon="fa-coffee"
                        groups="hr.group_hr_user">
                    <field name="allowance_order_count" widget="statinfo"
                           string="Allowance Orders"/>
                </button>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Allowance" name="staff_allowance"
                      groups="hr.group_hr_user">
                    <group>
                        <group>
                            <field name="allowance_plan_id"/>
                        </group>
                        <group>
                            <field name="allowance_over_count"
                                   string="Over-Limit Orders" readonly="1"/>
                        </group>
                    </group>
                    <div class="mb-2">
                        <button name="action_apply_allowance_plan" type="object"
                                string="Copy Plan Into Rules" class="btn-secondary"
                                icon="fa-clone" invisible="not allowance_plan_id"/>
                    </div>
                    <field name="allowance_rule_ids"
                           context="{'default_employee_id': id}">
                        <list editable="bottom"
                              decoration-danger="status in ('reached', 'over')"
                              decoration-warning="status == 'near'">
                            <field name="pos_category_id"/>
                            <field name="daily_limit"/>
                            <field name="count_mode" optional="hide"/>
                            <field name="policy"/>
                            <field name="tolerance" optional="hide"/>
                            <field name="used_today"/>
                            <field name="remaining_today"/>
                            <field name="status" widget="badge"
                                   decoration-success="status == 'ok'"
                                   decoration-warning="status == 'near'"
                                   decoration-danger="status in ('reached', 'over')"/>
                        </list>
                    </field>
                    <div class="text-muted mt-2">
                        Every POS category is free for this employee unless it is listed here, or covered by the plan above. Adding a rule affects only this employee. A limit of 0 blocks the category outright. Quotas reset at their local midnight.
                    </div>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
