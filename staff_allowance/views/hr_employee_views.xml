<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Limits live on the employee's work contact. The employee form shows
         them, read-only, and sends you to the contact to change them. -->
    <record id="view_employee_form_allowance" model="ir.ui.view">
        <field name="name">hr.employee.form.allowance</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_allowance_orders" type="object"
                        class="oe_stat_button" icon="fa-coffee"
                        groups="hr.group_hr_user"
                        invisible="not work_contact_id">
                    <field name="allowance_order_count" widget="statinfo"
                           string="Allowance Orders"/>
                </button>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Allowance" name="staff_allowance"
                      groups="hr.group_hr_user">
                    <div class="alert alert-warning" role="alert"
                         invisible="work_contact_id">
                        Save the employee first: Odoo creates their work contact on save.
                    </div>
                    <group>
                        <group string="Allowance Plan">
                            <field name="allowance_plan_id" placeholder="Select an allowance plan..."/>
                            <field name="allowance_summary" readonly="1" invisible="not allowance_summary"/>
                        </group>
                        <group string="Today's Status">
                            <field name="allowance_status" widget="badge"
                                   decoration-success="allowance_status == 'ok'"
                                   decoration-warning="allowance_status == 'near'"
                                   decoration-danger="allowance_status in ('reached', 'over')"
                                   decoration-muted="allowance_status == 'none'"
                                   invisible="not allowance_plan_id and not allowance_rule_ids"/>
                            <field name="allowance_over_count" string="Over-Limit Orders"
                                   invisible="allowance_over_count == 0"/>
                        </group>
                    </group>
                    <div class="d-flex align-items-center gap-3 mb-2" invisible="not work_contact_id">
                        <span class="fw-bold flex-grow-1 text-muted">Personal Rule Overrides (optional)</span>
                        <button name="action_edit_allowance" type="object"
                                string="Customize Limits" class="btn-link"
                                icon="fa-pencil"/>
                    </div>
                    <field name="allowance_rule_ids" readonly="1" invisible="not allowance_rule_ids">
                        <list decoration-danger="status in ('reached', 'over')"
                              decoration-warning="status == 'near'">
                            <field name="pos_category_id"/>
                            <field name="daily_limit"/>
                            <field name="policy"/>
                            <field name="used_today"/>
                            <field name="remaining_today"/>
                            <field name="status" widget="badge"
                                   decoration-success="status == 'ok'"
                                   decoration-warning="status == 'near'"
                                   decoration-danger="status in ('reached', 'over')"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

    <record id="view_employee_tree_allowance" model="ir.ui.view">
        <field name="name">hr.employee.list.allowance</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='work_email']" position="after">
                <field name="allowance_plan_id" optional="show"/>
                <field name="allowance_status" widget="badge"
                       decoration-success="allowance_status == 'ok'"
                       decoration-warning="allowance_status == 'near'"
                       decoration-danger="allowance_status in ('reached', 'over')"
                       decoration-muted="allowance_status == 'none'"
                       optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>
