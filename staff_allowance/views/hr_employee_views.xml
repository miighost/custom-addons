<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_form_allowance" model="ir.ui.view">
        <field name="name">hr.employee.form.allowance</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_allowance_orders" type="object"
                        class="oe_stat_button" icon="fa-coffee"
                        groups="hr.group_hr_user">
                    <field name="allowance_order_count" widget="statinfo"
                           string="Allowance Orders"/>
                </button>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Allowance" name="staff_allowance"
                      groups="hr.group_hr_user">
                    <group>
                        <group>
                            <field name="allowance_plan_id"/>
                        </group>
                        <group>
                            <field name="allowance_over_count"
                                   string="Over-Limit Orders" readonly="1"/>
                        </group>
                    </group>
                    <div class="mb-2">
                        <button name="action_apply_allowance_plan" type="object"
                                string="Copy Plan Limits" class="btn-secondary"
                                icon="fa-clone" invisible="not allowance_plan_id"/>
                        <button name="action_add_missing_allowances" type="object"
                                string="Add All Categories" class="btn-secondary"
                                icon="fa-plus"/>
                    </div>
                    <field name="allowance_line_ids"
                           context="{'default_employee_id': id}">
                        <list editable="bottom"
                              decoration-danger="status in ('reached', 'over', 'blocked')"
                              decoration-warning="status == 'near'">
                            <field name="category_id"/>
                            <field name="daily_limit" string="Daily Limit"/>
                            <field name="used_today"/>
                            <field name="remaining_today"/>
                            <field name="overdraft_today" optional="hide"/>
                            <field name="status" widget="badge"
                                   decoration-success="status == 'ok'"
                                   decoration-warning="status == 'near'"
                                   decoration-danger="status in ('reached', 'over', 'blocked')"/>
                            <field name="resets_at" optional="hide"/>
                            <field name="allowed" widget="boolean_toggle"/>
                        </list>
                    </field>
                    <div class="text-muted mt-2">
                        Limits cascade: a line here wins over the plan, the plan
                        wins over the category default. Categories with no line
                        and no plan entry fall back to their own default, unless
                        they are marked "Assigned Only". Quotas reset at this
                        employee's local midnight.
                    </div>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
