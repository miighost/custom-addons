<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_allowance_plan_list" model="ir.ui.view">
        <field name="name">staff.allowance.plan.list</field>
        <field name="model">staff.allowance.plan</field>
        <field name="arch" type="xml">
            <list string="Allowance Plans">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="strict"/>
                <field name="employee_count"/>
                <field name="partner_count"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_allowance_plan_form" model="ir.ui.view">
        <field name="name">staff.allowance.plan.form</field>
        <field name="model">staff.allowance.plan</field>
        <field name="arch" type="xml">
            <form string="Allowance Plan">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_employees" type="object"
                                class="oe_stat_button" icon="fa-users">
                            <field name="employee_count" widget="statinfo"
                                   string="Employees"/>
                        </button>
                        <button name="action_view_partners" type="object"
                                class="oe_stat_button" icon="fa-address-book">
                            <field name="partner_count" widget="statinfo"
                                   string="Contacts"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Staff"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="strict"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Category Limits" name="limits">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="category_id"/>
                                    <field name="category_default"/>
                                    <field name="unlimited" widget="boolean_toggle"/>
                                    <field name="daily_limit" readonly="unlimited"/>
                                </list>
                            </field>
                            <div class="text-muted mt-2">
                                These limits apply to everyone on this plan, unless
                                the person has a personal line in their own
                                Allowance tab.
                            </div>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_allowance_plan" model="ir.actions.act_window">
        <field name="name">Plans</field>
        <field name="res_model">staff.allowance.plan</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create an allowance plan</p>
            <p>A plan is a reusable tier of limits — Staff, Manager, VIP Customer —
               that you assign in one click instead of editing every person.</p>
        </field>
    </record>

</odoo>
