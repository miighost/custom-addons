<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_allowance_plan_list" model="ir.ui.view">
        <field name="name">staff.allowance.plan.list</field>
        <field name="model">staff.allowance.plan</field>
        <field name="arch" type="xml">
            <list string="Allowance Plans">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="partner_count"/>
            </list>
        </field>
    </record>

    <record id="view_allowance_plan_form" model="ir.ui.view">
        <field name="name">staff.allowance.plan.form</field>
        <field name="model">staff.allowance.plan</field>
        <field name="arch" type="xml">
            <form string="Allowance Plan">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_partners" type="object"
                                class="oe_stat_button" icon="fa-users">
                            <field name="partner_count" widget="statinfo"
                                   string="People"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Kitchen Staff"/></h1>
                    </div>
                    <field name="active" invisible="1"/>
                    <notebook>
                        <page string="Category Limits" name="limits">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="pos_category_id"/>
                                    <field name="daily_limit"/>
                                    <field name="count_mode" optional="hide"/>
                                    <field name="policy"/>
                                    <field name="tolerance"
                                           invisible="policy == 'block'"/>
                                </list>
                            </field>
                            <div class="text-muted mt-2">
                                Only the categories listed here are capped.
                                Anything else stays free for people on this plan.
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_allowance_plan" model="ir.actions.act_window">
        <field name="name">Plans</field>
        <field name="res_model">staff.allowance.plan</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create an allowance plan</p>
            <p>A reusable tier of limits you assign in one click instead of
               writing the same rules for every person.</p>
        </field>
    </record>

</odoo>
