<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_allowance_line_list" model="ir.ui.view">
        <field name="name">staff.allowance.line.list</field>
        <field name="model">staff.allowance.line</field>
        <field name="arch" type="xml">
            <list string="Allowances" editable="bottom">
                <field name="employee_id"/>
                <field name="partner_id"/>
                <field name="category_id"/>
                <field name="daily_limit"/>
                <field name="used_today"/>
                <field name="remaining_today"/>
                <field name="overdraft_today" optional="hide"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'ok'"
                       decoration-warning="status == 'near'"
                       decoration-danger="status in ('reached', 'over', 'blocked')"/>
                <field name="allowed" widget="boolean_toggle"/>
                <field name="beneficiary_type" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_allowance_line_form" model="ir.ui.view">
        <field name="name">staff.allowance.line.form</field>
        <field name="model">staff.allowance.line</field>
        <field name="arch" type="xml">
            <form string="Allowance">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_today_orders" type="object"
                                class="oe_stat_button" icon="fa-list">
                            <field name="used_today" widget="statinfo"
                                   string="Used Today"/>
                        </button>
                    </div>
                    <group>
                        <group string="Beneficiary">
                            <field name="employee_id"
                                   readonly="partner_id != False"/>
                            <field name="partner_id"
                                   readonly="employee_id != False"/>
                        </group>
                        <group string="Limit">
                            <field name="category_id"/>
                            <field name="daily_limit"/>
                            <field name="allowed"/>
                        </group>
                        <group string="Today">
                            <field name="used_today"/>
                            <field name="remaining_today"/>
                            <field name="overdraft_today"/>
                            <field name="status"/>
                            <field name="resets_at"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_allowance_line_search" model="ir.ui.view">
        <field name="name">staff.allowance.line.search</field>
        <field name="model">staff.allowance.line</field>
        <field name="arch" type="xml">
            <search string="Allowances">
                <field name="beneficiary_name" string="Beneficiary"/>
                <field name="employee_id"/>
                <field name="partner_id"/>
                <field name="category_id"/>
                <filter name="employees" string="Employees"
                        domain="[('beneficiary_type', '=', 'employee')]"/>
                <filter name="partners" string="Contacts"
                        domain="[('beneficiary_type', '=', 'partner')]"/>
                <separator/>
                <filter name="blocked" string="Blocked"
                        domain="[('allowed', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_category" string="Category"
                            context="{'group_by': 'category_id'}"/>
                    <filter name="group_type" string="Beneficiary Type"
                            context="{'group_by': 'beneficiary_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_allowance_line" model="ir.actions.act_window">
        <field name="name">Assignments</field>
        <field name="res_model">staff.allowance.line</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_category': 1}</field>
    </record>

</odoo>
