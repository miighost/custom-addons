<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_allowance_usage_list" model="ir.ui.view">
        <field name="name">staff.allowance.usage.list</field>
        <field name="model">staff.allowance.usage</field>
        <field name="arch" type="xml">
            <list string="Daily Usage" create="false" sample="1"
                  decoration-danger="status == 'over'"
                  decoration-warning="status == 'reached'"
                  decoration-muted="status == 'blocked'">
                <field name="day"/>
                <field name="beneficiary_name" string="Beneficiary"/>
                <field name="beneficiary_type" optional="hide"/>
                <field name="category_id"/>
                <field name="used" sum="Used"/>
                <field name="unlimited" optional="show"/>
                <field name="limit_value"/>
                <field name="remaining"/>
                <field name="over_by" sum="Over By"/>
                <field name="order_count" optional="hide"/>
                <field name="origin" optional="hide"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'ok'"
                       decoration-warning="status == 'near'"
                       decoration-danger="status in ('reached', 'over', 'blocked')"/>
                <field name="company_id" groups="base.group_multi_company"
                       optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_allowance_usage_form" model="ir.ui.view">
        <field name="name">staff.allowance.usage.form</field>
        <field name="model">staff.allowance.usage</field>
        <field name="arch" type="xml">
            <form string="Daily Usage" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="partner_id"/>
                            <field name="category_id"/>
                            <field name="day"/>
                        </group>
                        <group>
                            <field name="used"/>
                            <field name="unlimited"/>
                            <field name="limit_value"/>
                            <field name="remaining"/>
                            <field name="over_by"/>
                            <field name="order_count"/>
                            <field name="origin"/>
                            <field name="status"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="view_allowance_usage_pivot" model="ir.ui.view">
        <field name="name">staff.allowance.usage.pivot</field>
        <field name="model">staff.allowance.usage</field>
        <field name="arch" type="xml">
            <pivot string="Daily Usage" sample="1">
                <field name="beneficiary_name" type="row"/>
                <field name="category_id" type="col"/>
                <field name="used" type="measure"/>
                <field name="over_by" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_allowance_usage_graph" model="ir.ui.view">
        <field name="name">staff.allowance.usage.graph</field>
        <field name="model">staff.allowance.usage</field>
        <field name="arch" type="xml">
            <graph string="Daily Usage" sample="1">
                <field name="day"/>
                <field name="category_id"/>
                <field name="used" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_allowance_usage" model="ir.actions.act_window">
        <field name="name">Daily Usage</field>
        <field name="res_model">staff.allowance.usage</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No consumption recorded yet</p>
            <p>One row per person, category and day — searchable, groupable and
               ready for pivots, unlike a figure recomputed on the fly.</p>
        </field>
    </record>

    <record id="action_allowance_usage_reached" model="ir.actions.act_window">
        <field name="name">At or Over Limit</field>
        <field name="res_model">staff.allowance.usage</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="domain">[('status', 'in', ['reached', 'over'])]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nobody has hit their limit</p>
            <p>Everyone who has used up their daily allowance, and by how much
               they went over where that is permitted.</p>
        </field>
    </record>

</odoo>
