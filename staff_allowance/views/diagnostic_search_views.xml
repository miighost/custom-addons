<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================================================================
         DIAGNOSTIC FILE - not loaded by default.

         Four constructs are present in both search views that failed, and
         absent from the one that loads. Each record below adds exactly ONE
         of them to a baseline that is otherwise identical to the search view
         that works. Records load top to bottom and Odoo stops at the first
         invalid one, so the id it names in the error IS the culprit.

         To run the bisect:
           1. add  "views/diagnostic_search_views.xml",  to the data list in
              __manifest__.py, right after staff_allowance_order_views.xml
           2. restart Odoo and upgrade the module
           3. send me the record id from the error, or "all passed"

         priority 99 keeps these out of the way of the real views.
         Delete the file (and the manifest line) once we have the answer.
         ================================================================== -->

    <!-- A - baseline: one plain stored Char. Mirrors the view that works. -->
    <record id="diag_a_baseline" model="ir.ui.view">
        <field name="name">diag.a.baseline</field>
        <field name="model">staff.allowance.order</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <search string="Diag A">
                <field name="name"/>
            </search>
        </field>
    </record>

    <!-- B - adds a string= label on a search field -->
    <record id="diag_b_string_attr" model="ir.ui.view">
        <field name="name">diag.b.string.attr</field>
        <field name="model">staff.allowance.order</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <search string="Diag B">
                <field name="name" string="Reference"/>
            </search>
        </field>
    </record>

    <!-- C - adds a many2one search field -->
    <record id="diag_c_many2one" model="ir.ui.view">
        <field name="name">diag.c.many2one</field>
        <field name="model">staff.allowance.order</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <search string="Diag C">
                <field name="name"/>
                <field name="category_id"/>
            </search>
        </field>
    </record>

    <!-- D - adds a field inherited from the beneficiary mixin
             (stored computed Char) -->
    <record id="diag_d_mixin_field" model="ir.ui.view">
        <field name="name">diag.d.mixin.field</field>
        <field name="model">staff.allowance.order</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <search string="Diag D">
                <field name="name"/>
                <field name="beneficiary_name"/>
            </search>
        </field>
    </record>

    <!-- E - adds a filter whose domain uses a mixin Selection field -->
    <record id="diag_e_mixin_domain" model="ir.ui.view">
        <field name="name">diag.e.mixin.domain</field>
        <field name="model">staff.allowance.order</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <search string="Diag E">
                <field name="name"/>
                <filter name="diag_e_emp" string="Employees"
                        domain="[('beneficiary_type', '=', 'employee')]"/>
            </search>
        </field>
    </record>

    <!-- F - adds a group_by filter -->
    <record id="diag_f_group_by" model="ir.ui.view">
        <field name="name">diag.f.group.by</field>
        <field name="model">staff.allowance.order</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <search string="Diag F">
                <field name="name"/>
                <filter name="diag_f_grp" string="Category"
                        context="{'group_by': 'category_id'}"/>
            </search>
        </field>
    </record>

    <!-- G - adds the <group> Group By wrapper -->
    <record id="diag_g_group_wrapper" model="ir.ui.view">
        <field name="name">diag.g.group.wrapper</field>
        <field name="model">staff.allowance.order</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <search string="Diag G">
                <field name="name"/>
                <group expand="0" string="Group By">
                    <filter name="diag_g_grp" string="Category"
                            context="{'group_by': 'category_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- H - adds a date filter built with context_today() -->
    <record id="diag_h_context_today" model="ir.ui.view">
        <field name="name">diag.h.context.today</field>
        <field name="model">staff.allowance.order</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <search string="Diag H">
                <field name="name"/>
                <filter name="diag_h_today" string="Today"
                        domain="[('order_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
            </search>
        </field>
    </record>

</odoo>
