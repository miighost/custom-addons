<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Banquet Order & Quotation Report Action -->
    <record id="action_report_banquet_order" model="ir.actions.report">
        <field name="name">Banquet Quotation / Contract</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hotel_banquet_management.report_banquet_order_document</field>
        <field name="report_file">hotel_banquet_management.report_banquet_order_document</field>
        <field name="binding_type">report</field>
    </record>

    <!-- Banquet QWeb Template -->
    <template id="report_banquet_order_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)" />
                    
                    <div class="page" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 11px; color: #212529;">
                        <style>
                            .banquet-banner { border: 1px solid #1a252f; padding: 10px 14px; margin-bottom: 15px; background-color: #f8f9fa; }
                            .banquet-title { font-size: 20px; font-weight: 900; letter-spacing: 1px; text-transform: uppercase; margin: 0; color: #1a252f; }
                            .banquet-badge { float: right; border: 2px solid #1a252f; padding: 4px 12px; font-weight: 900; font-size: 13px; background: #fff; }
                            .info-table { width: 100%; margin-bottom: 15px; font-size: 11px; }
                            .info-table td { padding: 4px 6px; vertical-align: top; }
                            .lines-table { width: 100%; border-collapse: collapse; margin-top: 10px; margin-bottom: 15px; font-size: 11px; }
                            .lines-table th { background-color: #1a252f; color: #ffffff; font-weight: bold; border: 1px solid #1a252f; padding: 6px 8px; text-align: left; }
                            .lines-table td { border: 1px solid #dee2e6; padding: 6px 8px; }
                            .lines-table tr.total-row td { font-weight: bold; background-color: #f8f9fa; border-top: 2px solid #1a252f; }
                            .text-right { text-align: right; }
                            .text-center { text-align: center; }
                            .terms-box { border: 1px solid #ccc; padding: 10px 14px; margin-top: 15px; background: #fdfdfd; border-radius: 4px; page-break-inside: avoid; }
                            .sign-box { width: 45%; border-top: 1px solid #333; margin-top: 40px; padding-top: 6px; text-align: center; }
                        </style>

                        <!-- Header Banner -->
                        <div class="banquet-banner">
                            <div class="banquet-badge">
                                <t t-esc="doc.name"/>
                            </div>
                            <h2 class="banquet-title">
                                <t t-if="doc.doc_print_mode == 'proforma'">PROFORMA INVOICE</t>
                                <t t-elif="doc.doc_print_mode == 'order' or doc.state in ['sale', 'done']">BANQUET CONTRACT &amp; ORDER</t>
                                <t t-else="">BANQUET QUOTATION</t>
                            </h2>
                        </div>

                        <!-- Client & Event Info Table -->
                        <table class="info-table">
                            <tr>
                                <td style="width: 50%;">
                                    <strong style="font-size: 12px; color: #1a252f;">CLIENT / COMPANY DETAILS:</strong>
                                    <div style="margin-top: 4px; font-size: 12px; font-weight: bold;"><t t-esc="doc.partner_id.name"/></div>
                                    <div t-if="doc.partner_id.parent_id"><t t-esc="doc.partner_id.parent_id.name"/></div>
                                    <div t-if="doc.partner_id.street"><t t-esc="doc.partner_id.street"/></div>
                                    <div t-if="doc.partner_id.city or doc.partner_id.country_id">
                                        <t t-esc="doc.partner_id.city"/>, <t t-esc="doc.partner_id.country_id.name"/>
                                    </div>
                                    <div t-if="doc.partner_id.phone">
                                        <strong>Phone:</strong> <t t-esc="doc.partner_id.phone"/>
                                    </div>
                                    <div t-if="doc.partner_id.email">
                                        <strong>Email:</strong> <t t-esc="doc.partner_id.email"/>
                                    </div>
                                </td>
                                <td style="width: 50%;">
                                    <strong style="font-size: 12px; color: #1a252f;">EVENT &amp; FUNCTION DETAILS:</strong>
                                    <div style="margin-top: 4px;">
                                        <strong>Event Name:</strong> <span style="font-weight: bold; color: #000;"><t t-esc="doc.event_name or 'N/A'"/></span>
                                    </div>
                                    <div t-if="doc.event_type_id">
                                        <strong>Event Type:</strong> <t t-esc="doc.event_type_id.name"/>
                                    </div>
                                    <div t-if="doc.banquet_venue_id">
                                        <strong>Venue / Hall:</strong> <span style="font-weight: bold;"><t t-esc="doc.banquet_venue_id.name"/></span>
                                    </div>
                                    <div t-if="doc.event_start_date">
                                        <strong>Start Date:</strong> <t t-esc="doc.event_start_date" t-options='{"widget": "datetime", "format": "dd/MM/yyyy HH:mm"}'/>
                                    </div>
                                    <div t-if="doc.event_end_date">
                                        <strong>End Date:</strong> <t t-esc="doc.event_end_date" t-options='{"widget": "datetime", "format": "dd/MM/yyyy HH:mm"}'/>
                                    </div>
                                    <div>
                                        <strong>Guests / Pax:</strong> <span style="font-weight: bold;"><t t-esc="doc.guest_count or '-'"/> Pax</span>
                                    </div>
                                    <div t-if="doc.date_order">
                                        <strong>Date:</strong> <t t-esc="doc.date_order" t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <!-- Order Lines Table -->
                        <table class="lines-table">
                            <thead>
                                <tr>
                                    <th style="width: 32%;">Product / Service</th>
                                    <th style="width: 20%;">Description</th>
                                    <th class="text-center" style="width: 8%;">Qty</th>
                                    <th class="text-center" style="width: 10%;">No of Days</th>
                                    <th class="text-right" style="width: 14%;">Unit Price</th>
                                    <th class="text-right" style="width: 16%;">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="lines_to_report" t-value="doc._get_order_lines_to_report()" />
                                <t t-foreach="lines_to_report" t-as="line">
                                    <t t-if="not line.display_type">
                                        <tr>
                                            <td><strong><t t-esc="line.product_id.name"/></strong></td>
                                            <td><t t-esc="line.name"/></td>
                                            <td class="text-center"><t t-esc="line.product_uom_qty"/></td>
                                            <td class="text-center"><strong><t t-esc="line.number_of_days or 1"/></strong></td>
                                            <td class="text-right"><t t-esc="line.price_unit" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                                            <td class="text-right"><strong><t t-esc="line.price_subtotal" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></strong></td>
                                        </tr>
                                    </t>
                                    <t t-elif="line.display_type == 'line_section'">
                                        <tr style="background-color: #e9ecef; font-weight: bold;">
                                            <td colspan="6"><t t-esc="line.name"/></td>
                                        </tr>
                                    </t>
                                    <t t-elif="line.display_type == 'line_note'">
                                        <tr style="font-style: italic; color: #555;">
                                            <td colspan="6">Note: <t t-esc="line.name"/></td>
                                        </tr>
                                    </t>
                                </t>
                            </tbody>
                        </table>

                        <!-- Totals Section -->
                        <div class="clearfix" style="margin-top: 10px;">
                            <div class="row justify-content-end" style="float: right; width: 45%;">
                                <table class="table-custom" style="width: 100%; border-collapse: collapse; font-size: 11px;">
                                    <tr>
                                        <td style="padding: 4px 6px; border-top: 1px solid #ccc;"><strong>Untaxed Amount:</strong></td>
                                        <td class="text-right" style="padding: 4px 6px; border-top: 1px solid #ccc;">
                                            <span t-field="doc.amount_untaxed"/>
                                        </td>
                                    </tr>
                                    <t t-if="doc.amount_tax">
                                        <tr>
                                            <td style="padding: 4px 6px;"><strong>Taxes:</strong></td>
                                            <td class="text-right" style="padding: 4px 6px;">
                                                <span t-field="doc.amount_tax"/>
                                            </td>
                                        </tr>
                                    </t>
                                    <tr style="background-color: #1a252f; color: #fff; font-size: 13px; font-weight: bold;">
                                        <td style="padding: 6px 8px;">Total Amount:</td>
                                        <td class="text-right" style="padding: 6px 8px;">
                                            <span t-field="doc.amount_total"/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Customer Notes -->
                        <div t-if="doc.note" style="margin-top: 20px; font-size: 11px; border-left: 3px solid #1a252f; padding-left: 10px;">
                            <strong>Special Instructions / Setup Notes:</strong>
                            <div t-field="doc.note"/>
                        </div>

                        <!-- Terms and Conditions Section -->
                        <div t-if="doc.terms_and_conditions" class="terms-box">
                            <div t-out="doc.terms_and_conditions"/>
                        </div>

                        <!-- Signatures Box -->
                        <div style="margin-top: 40px; page-break-inside: avoid;">
                            <table style="width: 100%;">
                                <tr>
                                    <td style="width: 45%; text-align: center;">
                                        <div style="border-top: 1px solid #333; margin-top: 40px; padding-top: 6px; font-weight: bold;">
                                            Customer Acceptance / Signature
                                        </div>
                                    </td>
                                    <td style="width: 10%;"></td>
                                    <td style="width: 45%; text-align: center;">
                                        <div style="border-top: 1px solid #333; margin-top: 40px; padding-top: 6px; font-weight: bold;">
                                            Authorized Hotel Representative
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
