<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Banquet Order & Quotation Report Action -->
    <record id="action_report_banquet_order" model="ir.actions.report">
        <field name="name">Banquet Quotation / Order</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hotel_banquet_management.report_banquet_order_document</field>
        <field name="report_file">hotel_banquet_management.report_banquet_order_document</field>
        <field name="binding_type">report</field>
    </record>

    <!-- Banquet QWeb Template (100% Standard Odoo Layout & Styling) -->
    <template id="report_banquet_order_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)" />
                    
                    <!-- Standard Customer Address Block -->
                    <t t-set="address">
                        <div t-field="doc.partner_id"
                             t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}' />
                        <p t-if="doc.partner_id.vat"><t t-out="doc.company_id.account_fiscal_country_id.vat_label or 'Tax ID'"/>: <span t-field="doc.partner_id.vat"/></p>
                    </t>

                    <div class="page">
                        <div class="oe_structure"/>

                        <!-- Standard Document Title -->
                        <h2 class="mt-4">
                            <span t-if="doc.state in ['draft','sent']">Banquet Quotation # </span>
                            <span t-else="">Banquet Order # </span>
                            <span t-field="doc.name"/>
                        </h2>

                        <!-- Standard Information Block -->
                        <div class="row mt-4 mb-4" id="informations">
                            <div t-if="doc.event_name" class="col-auto col-3 mw-100 mb-2">
                                <strong>Event:</strong>
                                <p class="m-0" t-field="doc.event_name"/>
                            </div>
                            <div t-if="doc.event_type_id" class="col-auto col-3 mw-100 mb-2">
                                <strong>Event Type:</strong>
                                <p class="m-0" t-field="doc.event_type_id.name"/>
                            </div>
                            <div t-if="doc.banquet_venue_id" class="col-auto col-3 mw-100 mb-2">
                                <strong>Venue / Hall:</strong>
                                <p class="m-0" t-field="doc.banquet_venue_id.name"/>
                            </div>
                            <div t-if="doc.event_start_date" class="col-auto col-3 mw-100 mb-2">
                                <strong>Event Date:</strong>
                                <p class="m-0" t-field="doc.event_start_date" t-options='{"widget": "datetime", "format": "dd/MM/yyyy HH:mm"}'/>
                            </div>
                            <div t-if="doc.date_order" class="col-auto col-3 mw-100 mb-2">
                                <strong>Order Date:</strong>
                                <p class="m-0" t-field="doc.date_order" t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/>
                            </div>
                            <div t-if="doc.user_id.name" class="col-auto col-3 mw-100 mb-2">
                                <strong>Salesperson:</strong>
                                <p class="m-0" t-field="doc.user_id"/>
                            </div>
                        </div>

                        <!-- Standard Lines Table -->
                        <t t-set="lines_to_report" t-value="doc._get_order_lines_to_report()"/>
                        <t t-set="display_discount" t-value="any(l.discount for l in lines_to_report)"/>

                        <table class="table table-sm o_main_table table-borderless mt-4">
                            <thead style="display: table-row-group">
                                <tr>
                                    <th name="th_description" class="text-start">Description</th>
                                    <th name="th_quantity" class="text-end">Quantity</th>
                                    <th name="th_number_of_days" class="text-end">No of Days</th>
                                    <th name="th_priceunit" class="text-end">Unit Price</th>
                                    <th name="th_discount" t-if="display_discount" class="text-end">
                                        <span>Disc.%</span>
                                    </th>
                                    <th name="th_taxes" class="text-end">Taxes</th>
                                    <th name="th_subtotal" class="text-end">
                                        <span>Amount</span>
                                    </th>
                                </tr>
                            </thead>
                            <tbody class="sale_tbody">
                                <t t-foreach="lines_to_report" t-as="line">
                                    <tr t-att-class="'bg-200 fw-bold o_line_section' if line.display_type == 'line_section' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">
                                        <t t-if="not line.display_type">
                                            <td name="td_name"><span t-field="line.name"/></td>
                                            <td name="td_quantity" class="text-end">
                                                <span t-field="line.product_uom_qty"/>
                                                <span t-field="line.product_uom"/>
                                            </td>
                                            <td name="td_number_of_days" class="text-end">
                                                <span t-field="line.number_of_days"/>
                                            </td>
                                            <td name="td_priceunit" class="text-end">
                                                <span t-field="line.price_unit"/>
                                            </td>
                                            <td t-if="display_discount" class="text-end">
                                                <span t-field="line.discount"/>
                                            </td>
                                            <td name="td_taxes" class="text-end">
                                                <span t-out="', '.join(map(lambda x: (x.description or x.name), line.tax_ids))"/>
                                            </td>
                                            <td name="td_subtotal" class="text-end o_price_total">
                                                <span t-field="line.price_subtotal"/>
                                            </td>
                                        </t>
                                        <t t-elif="line.display_type == 'line_section'">
                                            <td name="td_section_line" colspan="99">
                                                <span t-field="line.name"/>
                                            </td>
                                        </t>
                                        <t t-elif="line.display_type == 'line_note'">
                                            <td name="td_note_line" colspan="99">
                                                <span t-field="line.name"/>
                                            </td>
                                        </t>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Standard Totals Summary Block -->
                        <div class="clearfix" name="so_total_summary">
                            <div id="total" class="row" name="total">
                                <div t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ms-auto">
                                    <table class="table table-sm table-borderless">
                                        <tr class="border-black o_subtotal" style="">
                                            <td><strong>Untaxed Amount</strong></td>
                                            <td class="text-end">
                                                <span t-field="doc.amount_untaxed"/>
                                            </td>
                                        </tr>
                                        <t t-if="doc.amount_tax">
                                            <tr>
                                                <td><strong>Taxes</strong></td>
                                                <td class="text-end">
                                                    <span t-field="doc.amount_tax"/>
                                                </td>
                                            </tr>
                                        </t>
                                        <tr class="border-black o_total">
                                            <td><strong>Total</strong></td>
                                            <td class="text-end">
                                                <span t-field="doc.amount_total"/>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- Standard Customer Notes -->
                        <div t-if="doc.note" class="mt-4">
                            <span t-field="doc.note"/>
                        </div>

                        <!-- Standard Payment Terms -->
                        <div t-if="doc.payment_term_id" class="mt-2">
                            <span t-field="doc.payment_term_id.note"/>
                        </div>

                        <!-- Standard Terms and Conditions Section -->
                        <div t-if="doc.terms_and_conditions" class="mt-4">
                            <div t-out="doc.terms_and_conditions"/>
                        </div>

                        <div class="oe_structure"/>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
