<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Banquet Partner Ledger Wizard Form View -->
    <record id="view_banquet_partner_ledger_form" model="ir.ui.view">
        <field name="name">banquet.partner.ledger.form</field>
        <field name="model">banquet.partner.ledger.wizard</field>
        <field name="arch" type="xml">
            <form string="Customer / Partner Ledger">
                <sheet>
                    <group>
                        <group string="Customer / Company">
                            <field name="partner_id" string="Customer / Company" options="{'no_create': True}"/>
                            <field name="include_initial_balance"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Date Range">
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_print_ledger" string="Print Partner Ledger (PDF)" type="object" class="btn-primary" icon="fa-file-pdf-o"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action for Partner Ledger Wizard -->
    <record id="action_banquet_partner_ledger" model="ir.actions.act_window">
        <field name="name">Customer / Partner Ledger</field>
        <field name="res_model">banquet.partner.ledger.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
