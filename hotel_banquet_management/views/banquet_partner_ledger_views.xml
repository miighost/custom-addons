<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 1. Interactive On-Screen Partner Ledger List View -->
    <record id="view_banquet_partner_ledger_tree" model="ir.ui.view">
        <field name="name">banquet.partner.ledger.list</field>
        <field name="model">account.move.line</field>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <list string="Customer &amp; Partner Ledger Entries" create="false" edit="false">
                <field name="date" string="Date"/>
                <field name="partner_id" string="Customer / Company"/>
                <field name="journal_id" string="JRNL"/>
                <field name="move_name" string="Entry / Ref #" decoration-bf="1"/>
                <field name="name" string="Description / Label"/>
                <field name="matching_number" string="Matching" optional="show"/>
                <field name="debit" string="Debit (Billed)" sum="Total Debit" decoration-bf="1"/>
                <field name="credit" string="Credit (Paid)" sum="Total Credit" decoration-success="credit > 0" decoration-bf="1"/>
                <field name="balance" string="Balance" sum="Net Balance" decoration-bf="1"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- Action 1: Live On-Screen Partner Ledger List View -->
    <record id="action_banquet_view_partner_ledger" model="ir.actions.act_window">
        <field name="name">View Partner Ledger</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="domain">[('account_id.account_type', '=', 'asset_receivable'), ('parent_state', '=', 'posted')]</field>
        <field name="context">{'search_default_group_by_partner': 1}</field>
        <field name="view_id" ref="view_banquet_partner_ledger_tree"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                View Customer &amp; Partner Ledger live on screen!
            </p>
            <p>
                Browse all transactions, billings (debit), payments received (credit), and running balances per client.
            </p>
        </field>
    </record>

    <!-- 2. PDF Partner Ledger Wizard Form View -->
    <record id="view_banquet_partner_ledger_form" model="ir.ui.view">
        <field name="name">banquet.partner.ledger.form</field>
        <field name="model">banquet.partner.ledger.wizard</field>
        <field name="arch" type="xml">
            <form string="Print Customer / Partner Ledger">
                <sheet>
                    <group>
                        <group string="Customer / Company">
                            <field name="partner_id" string="Customer / Company" options="{'no_create': True}"/>
                            <field name="include_initial_balance"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Date Range">
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_print_ledger" string="Print Partner Ledger (PDF)" type="object" class="btn-primary" icon="fa-file-pdf-o"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action 2: PDF Partner Ledger Wizard Action -->
    <record id="action_banquet_partner_ledger_wizard" model="ir.actions.act_window">
        <field name="name">Print Partner Ledger (PDF)</field>
        <field name="res_model">banquet.partner.ledger.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
