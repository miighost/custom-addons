<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Banquet Event Type List View -->
    <record id="view_banquet_event_type_tree" model="ir.ui.view">
        <field name="name">banquet.event.type.list</field>
        <field name="model">banquet.event.type</field>
        <field name="arch" type="xml">
            <list string="Banquet Event Types">
                <field name="name"/>
                <field name="code"/>
                <field name="description"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Banquet Event Type Form View -->
    <record id="view_banquet_event_type_form" model="ir.ui.view">
        <field name="name">banquet.event.type.form</field>
        <field name="model">banquet.event.type</field>
        <field name="arch" type="xml">
            <form string="Banquet Event Type">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" placeholder="Brief notes about this event type..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action for Banquet Event Types -->
    <record id="action_banquet_event_type" model="ir.actions.act_window">
        <field name="name">Event Types</field>
        <field name="res_model">banquet.event.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Banquet Event Type (e.g. Wedding, Conference, Meeting, Birthday)!
            </p>
        </field>
    </record>
</odoo>
