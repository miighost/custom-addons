<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Partner Form View to Add Banquet Smart Button -->
    <record id="view_partner_form_banquet_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.banquet.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_banquet_orders"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-glass"
                        invisible="banquet_count == 0">
                    <field name="banquet_count" widget="statinfo" string="Banquets"/>
                </button>
            </div>
        </field>
    </record>

    <!-- Action for Banquet Customers -->
    <record id="action_banquet_customers" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'default_customer_rank': 1, 'res_partner_search_mode': 'customer'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Customer or Corporate Client for Banquets!
            </p>
            <p>
                Manage banquet organizers, corporate accounts, wedding clients, and event sponsors.
            </p>
        </field>
    </record>
</odoo>
