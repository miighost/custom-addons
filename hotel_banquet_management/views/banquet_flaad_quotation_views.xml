<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 1. Flaad Quotation List View -->
    <record id="view_banquet_flaad_quotation_tree" model="ir.ui.view">
        <field name="name">banquet.flaad.quotation.list</field>
        <field name="model">banquet.flaad.quotation</field>
        <field name="arch" type="xml">
            <list string="Flaad Quotations (Simulation)" decoration-info="state in ('draft', 'sent')" decoration-success="state == 'converted'" decoration-muted="state == 'cancel'">
                <field name="name" string="Quote #" decoration-bf="1"/>
                <field name="partner_id" string="Customer / Company"/>
                <field name="event_name" string="Event Name"/>
                <field name="event_type_id" string="Event Type"/>
                <field name="banquet_venue_id" string="Venue / Hall"/>
                <field name="event_start_date" string="Start Date &amp; Time"/>
                <field name="guest_count" string="Pax"/>
                <field name="amount_total" string="Total Amount" sum="Total" decoration-bf="1" widget="monetary"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" string="Status" widget="badge" decoration-info="state in ('draft', 'sent')" decoration-success="state == 'converted'" decoration-danger="state == 'cancel'"/>
                <field name="real_sale_order_id" string="Official Order" optional="show"/>
            </list>
        </field>
    </record>

    <!-- 2. Flaad Kanban View -->
    <record id="view_banquet_flaad_quotation_kanban" model="ir.ui.view">
        <field name="name">banquet.flaad.quotation.kanban</field>
        <field name="model">banquet.flaad.quotation</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="state"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between mb-1">
                            <strong class="o_kanban_record_title"><field name="name"/></strong>
                            <field name="amount_total" widget="monetary" class="fw-bold text-success"/>
                        </div>
                        <div class="text-muted fw-bold"><field name="partner_id"/></div>
                        <div class="text-truncate text-dark fw-bold mt-1"><i class="fa fa-glass me-1"/> <field name="event_name"/></div>
                        <div class="d-flex justify-content-between align-items-center mt-2 pt-1 border-top">
                            <span class="badge text-bg-light border"><field name="banquet_venue_id"/></span>
                            <span class="text-muted small"><field name="event_start_date"/></span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- 3. Flaad Calendar View -->
    <record id="view_banquet_flaad_quotation_calendar" model="ir.ui.view">
        <field name="name">banquet.flaad.quotation.calendar</field>
        <field name="model">banquet.flaad.quotation</field>
        <field name="arch" type="xml">
            <calendar string="Flaad Quotation Calendar"
                      date_start="event_start_date"
                      date_stop="event_end_date"
                      color="banquet_venue_id"
                      mode="month"
                      quick_create="0">
                <field name="partner_id"/>
                <field name="event_name"/>
                <field name="banquet_venue_id" filters="1"/>
                <field name="amount_total" widget="monetary"/>
            </calendar>
        </field>
    </record>

    <!-- 4. Flaad Form View -->
    <record id="view_banquet_flaad_quotation_form" model="ir.ui.view">
        <field name="name">banquet.flaad.quotation.form</field>
        <field name="model">banquet.flaad.quotation</field>
        <field name="arch" type="xml">
            <form string="Flaad Quotation (Simulation)">
                <header>
                    <button name="action_print" string="Print Flaad Quotation" type="object" class="btn-primary" icon="fa-print"/>
                    <button name="action_convert_to_real_order" string="Convert to Real Banquet Quote" type="object" class="btn-success" invisible="state in ['converted', 'cancel']" icon="fa-check-circle"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ['cancel', 'converted']"/>
                    <button name="action_draft" string="Reset to Draft" type="object" invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,converted"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert" style="margin-bottom: 15px;">
                        <i class="fa fa-info-circle me-1"/> <strong>Flaad Quotation (Sandbox Mode):</strong> This quotation is a simulation for price inquiries and does <u>not</u> affect your official sales database, general ledger, or accounting records.
                    </div>

                    <div class="oe_title">
                        <span class="o_form_label">Flaad Quotation Reference</span>
                        <h1 class="d-flex">
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Client &amp; Event Info">
                            <field name="partner_id" string="Customer / Company" widget="res_partner_many2one" context="{'res_partner_search_mode': 'customer', 'show_address': 1}" options='{"always_reload": True}' required="1"/>
                            <field name="event_name" string="Event / Function Name" placeholder="e.g. Wedding Reception / Corporate Dinner" required="1"/>
                            <field name="event_type_id" string="Event Type" options="{'no_create_edit': True}"/>
                            <field name="banquet_venue_id" string="Venue / Hall" options="{'no_create_edit': True}"/>
                        </group>
                        <group string="Date &amp; Details">
                            <field name="event_start_date" string="Start Date &amp; Time"/>
                            <field name="event_end_date" string="End Date &amp; Time"/>
                            <field name="guest_count" string="Guests / Pax"/>
                            <field name="date_order" string="Quote Date"/>
                            <field name="company_id" groups="base.group_multi_company" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="real_sale_order_id" invisible="not real_sale_order_id"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- Tab 1: Services & Order Lines -->
                        <page string="Services &amp; Order Lines" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id" string="Product / Service" domain="[('sale_ok', '=', True)]" required="1"/>
                                    <field name="name" string="Description"/>
                                    <field name="product_uom_qty" string="Qty" decoration-bf="1"/>
                                    <field name="number_of_days" string="No of Days" decoration-bf="1"/>
                                    <field name="price_unit" string="Unit Price" widget="monetary"/>
                                    <field name="tax_ids" string="Taxes" widget="many2many_tags" options="{'no_create': True}" optional="show"/>
                                    <field name="discount" string="Disc.%" optional="hide"/>
                                    <field name="price_subtotal" string="Subtotal" widget="monetary" decoration-bf="1"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                            <group name="note_group" col="6" class="mt-2 mt-md-0">
                                <group colspan="4">
                                    <field name="note" string="Special Notes" placeholder="Special requirements, catering notes, simulation details..."/>
                                </group>
                                <group class="oe_subtotal_footer oe_right" colspan="2" name="total_group">
                                    <field name="amount_untaxed" widget="monetary"/>
                                    <field name="amount_tax" widget="monetary"/>
                                    <field name="amount_total" class="oe_subtotal_footer_separator" widget="monetary"/>
                                </group>
                                <div class="clearfix"/>
                            </group>
                        </page>

                        <!-- Tab 2: Terms and Conditions -->
                        <page string="Terms &amp; Conditions" name="terms">
                            <field name="terms_and_conditions" placeholder="Type or customize your banquet terms..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Flaad Quotation Action -->
    <record id="action_banquet_flaad_quotations" model="ir.actions.act_window">
        <field name="name">Flaad Q</field>
        <field name="res_model">banquet.flaad.quotation</field>
        <field name="view_mode">list,kanban,calendar,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Flaad Quotation!
            </p>
            <p>
                Use Flaad Q to prepare sandbox price quotes and client estimates that will not affect official sales or accounting records.
            </p>
        </field>
    </record>

</odoo>
