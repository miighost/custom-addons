<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 1. Inherit Account Move Form View to show Number of Days column -->
    <record id="view_banquet_invoice_form_inherit" model="ir.ui.view">
        <field name="name">account.move.form.banquet.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='quantity']" position="after">
                <field name="number_of_days" optional="show" string="No of Days"/>
            </xpath>
        </field>
    </record>

    <!-- 2. Inherit Standard Invoice PDF Report to print 'No of Days' column -->
    <template id="report_invoice_document_banquet" inherit_id="account.report_invoice_document">
        <xpath expr="//th[@name='th_quantity']" position="after">
            <th name="th_number_of_days" class="text-end" t-if="o.is_banquet or any((l.number_of_days or 0.0) > 1.0 for l in o.invoice_line_ids)">
                <span>No of Days</span>
            </th>
        </xpath>
        <xpath expr="//td[@name='td_quantity']" position="after">
            <td name="td_number_of_days" class="text-end" t-if="o.is_banquet or any((l.number_of_days or 0.0) > 1.0 for l in o.invoice_line_ids)">
                <span t-field="line.number_of_days"/>
            </td>
        </xpath>
    </template>

</odoo>
