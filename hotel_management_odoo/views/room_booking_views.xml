<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--     Room Booking Form View -->
    <record id="room_booking_view_form" model="ir.ui.view">
        <field name="name">room.booking.view.form</field>
        <field name="model">room.booking</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_reserve" string="Reserve"
                            invisible="state != 'draft'" type="object"
                            class="btn-primary"/>
                    <button name="action_print_reservation_acknowledgement" string="Print Acknowledgement"
                            invisible="state not in ['reserved', 'check_in']" type="object"
                            class="btn-primary"/>
                    <button name="action_compute_bill" string="COMPUTE BILL"
                            invisible="state not in ['check_in', 'check_out', 'done'] or has_pos_orders == False"
                            type="object" class="btn-primary"/>
                    <button name="action_checkin" string="Check-In"
                            class="btn-primary"
                            invisible="is_checkin == True or (state in ['check_in','check_out','done','cancel'])"
                            type="object"/>
                    <button name="action_room_transfer" string="Transfer Room"
                            type="object" class="btn-primary" icon="fa-exchange"
                            invisible="state not in ['check_in', 'reserved'] or not room_line_ids"/>
                    <button name="action_maintenance_request"
                            string="Maintenance Request" type="object"
                            class="btn-primary"
                            invisible=" maintenance_request_sent == True or ( state not in ['check_in', 'reserved'])"/>
                    <button name="action_checkout" string="Check-Out"
                            class="btn-primary" invisible="state != 'check_in'"
                            type="object"/>
                    <button name="action_done" string="Set as Done"
                            class="btn-primary"
                            invisible="state != 'check_out'" type="object"/>
                    <button name="action_invoice" string="Create Invoice"
                            type="object" class="btn-primary"
                            invisible="state not in ['draft', 'check_out'] or invoice_button_visible == True"/>
                    <button name="action_cancel" string="Cancel"
                            invisible="state not in ['draft','reserved']"
                            type="object" class="btn-secondary"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,check_in,check_out,done"/>
                    <field name="invoice_status" widget="statusbar"
                           invisible="1"/>
                </header>
                <sheet>
                    <div name="button_box" position="inside">
                        <button class="oe_stat_button" type="object"
                                name="action_view_invoices"
                                invisible="invoice_status != 'invoiced'"
                                icon="fa-edit">
                            <field string="Invoices" name="invoice_count"
                                   widget="statinfo"/>
                        </button>
                    </div>
                    <div>
                        <h1>
                            <field name="folio_no" readonly="1"/>
                            <field name="name" invisible="1"/>
                        </h1>
                    </div>
                    <group>
                        <!-- Invisible Fields -->
                        <field name="is_checkin" invisible="1"/>
                        <field name="has_pos_orders" invisible="1"/>
                        <field name="duration" readonly="1" invisible="1"/>
                        <field name="duration_visible" invisible="1"/>
                        <field name="invoice_button_visible" invisible="1"/>
                        <field name="maintenance_request_sent" invisible="1"/>
                        <group>
                            <field name="partner_id"
                                   widget="res_partner_many2one"
                                   context="{'res_partner_search_mode': 'customer', 'show_address': 1, 'show_vat': True}"
                                   options="{'always_reload': True}"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}" readonly="state not in ['draft']"/>
                            <field name="user_id"
                                   domain="[('parent_id','=',partner_id)]"
                                   context="{'default_type':'invoice'}"
                                   options="{'always_reload': True}"
                                   invisible="user_id == partner_id"/>
                            <field name="is_long_stay" string="Long Stay (LSR)" widget="boolean_toggle"/>
                            <field name="is_private_reserved" string="Reserved (RR)" widget="boolean_toggle"/>
                            <field name="is_cr" string="Complimentary (CR)" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="checkin_date"/>
                            <field name="checkout_date"/>
                            <field name="date_order"/>
                            <field name="pricelist_id"/>
                            <field name="meal_plan_id" options="{'no_quick_create': False}"/>
                            <field name="need_service"
                                   invisible=" state not in ['check_in']"/>
                            <field name="need_fleet"
                                   invisible=" state not in ['check_in']"/>
                            <field name="need_food"
                                   invisible=" state not in ['check_in']"/>
                            <field name="need_event"
                                   invisible=" state not in ['check_in']"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="folio" string="Folio">
                            <field name="room_line_ids" colspan="4"
                                   string="Room Lines"
                                   context="{'default_checkin_date':checkin_date, 'default_checkout_date':checkout_date, 'default_uom_qty':duration}">
                                <list editable="bottom">
                                    <field name="is_special" column_invisible="True"/>
                                    <field name="room_id" string="Room"
                                           required="1"
                                           domain="['|', ('company_id', '=', False), ('company_id', '=', parent.company_id)]"
                                           decoration-info="is_special"
                                           options="{'no_open': True, 'no_create': True}"/>
                                    <field name="checkin_date"/>
                                    <field name="booking_line_visible"
                                           invisible="1"/>
                                    <field name="checkout_date"/>
                                    <field name="uom_qty" string="Duration"
                                           readonly="1" force_save="1"/>
                                    <field name="elapsed_days" string="Stayed Days"
                                           readonly="1" force_save="1"
                                           column_invisible="parent.state in ['draft', 'reserved']"/>
                                    <field name="uom_id"
                                           readonly="booking_line_visible == True"
                                           string="Unit of Measure"
                                           options="{'no_open': True, 'no_create': True}"/>
                                    <field name="price_unit"
                                           readonly="booking_line_visible == True"/>
                                    <field name="tax_ids"
                                           readonly="booking_line_visible == True "
                                           options="{'no_create': True}"
                                           widget="many2many_tags"/>
                                    <field name="price_subtotal"
                                           widget="monetary"
                                           readonly="booking_line_visible == True"/>
                                    <field name="today_accrued_rent"
                                           string="Today's Balance"
                                           widget="monetary"
                                           sum="Total Today's Balance"
                                           readonly="1"
                                           column_invisible="parent.state in ['draft', 'reserved']"/>
                                    <field groups="account.group_account_manager"
                                           name="price_total" widget="monetary"
                                           readonly="booking_line_visible == True"/>
                                </list>
                            </field>
                            <group colspan="2"
                                   class="oe_subtotal_footer oe_right">
                                <field name="amount_untaxed_room"
                                       sum="Untaxed amount for Room"
                                       widget="monetary"/>
                                <field name="amount_untaxed_food"
                                       sum="Untaxed amount for Food"
                                       widget="monetary"
                                       invisible="need_food == False"/>
                                <field name="amount_untaxed_service"
                                       sum="Untaxed amount for Service"
                                       widget="monetary"
                                       invisible="need_service == False"/>
                                <field name="amount_untaxed_fleet"
                                       sum="Untaxed amount for Fleet"
                                       widget="monetary"
                                       invisible="need_fleet == False"/>
                                <field name="amount_untaxed_event"
                                       sum="Untaxed amount for Event"
                                       widget="monetary"
                                       invisible="need_event == False"/>
                                <field name="amount_untaxed"
                                       sum="Untaxed amount" widget="monetary"/>
                                <field name="amount_tax" widget="monetary"/>
                                <label for="amount_total"/>
                                <field name="amount_total" nolabel="1"
                                       sum="Total amount" widget="monetary"/>
                                <field name="amount_accrued_today" widget="monetary" string="Accrued (Today)"
                                       invisible="state in ['draft', 'reserved']"/>
                                <field name="room_rate" widget="monetary" string="Daily Rate"/>
                                <field name="amount_paid" widget="monetary" string="Amount Paid" invisible="amount_paid == 0"/>
                                <div class="oe_subtotal_footer_separator oe_inline o_td_label"
                                     invisible="state in ['draft', 'reserved']">
                                    <label for="today_balance" string="Today's Due Balance" style="font-weight: bold; font-size: 14px; color: #0056b3;"/>
                                </div>
                                <field name="today_balance" nolabel="1" class="oe_subtotal_footer_separator" widget="monetary" style="font-weight: bold; font-size: 14px; color: #0056b3;"
                                       invisible="state in ['draft', 'reserved']"/>
                            </group>
                            <div class="oe_clear"/>
                        </page>
                        <page name="food" string="Food"
                              invisible="need_food == False ">
                            <field name="food_order_line_ids" colspan="4"
                                   string="Food Lines">
                                <list editable="bottom">
                                    <field name="food_id" string="Product"
                                           required="1"
                                           options="{'no_open': True,'no_create': True}"/>
                                    <field name="description"/>
                                    <field name="uom_qty" string="Qty"
                                           force_save="1"/>
                                    <field name="uom_id"
                                           string="Unit of Measure"
                                           options="{'no_open': True,'no_create': True}"/>
                                    <field name="price_unit"/>
                                    <field name="tax_ids"
                                           options="{'no_create': True}"
                                           widget="many2many_tags"/>
                                    <field name="price_subtotal"
                                           widget="monetary"/>
                                    <field groups="account.group_account_manager"
                                           name="price_total"
                                           widget="monetary"/>
                                </list>
                            </field>
                            <group colspan="2"
                                   class="oe_subtotal_footer oe_right">
                                <field name="amount_untaxed_food"
                                       sum="Untaxed amount for Food"
                                       widget="monetary"/>
                                <field name="amount_taxed_food"
                                       widget="monetary"/>
                                <label for="amount_total_food"/>
                                <field name="amount_total_food" nolabel="1"
                                       sum="Total amount" widget="monetary"/>
                            </group>
                            <div class="oe_clear"/>
                        </page>
                        <page name="service" string="Service"
                              invisible="need_service == False">
                            <field name="service_line_ids" colspan="4"
                                   string="Service Lines">
                                <list editable="bottom">
                                    <field name="service_id" string="Service"
                                           required="1"
                                           domain="['|', ('company_id', '=', False), ('company_id', '=', parent.company_id)]"
                                           options="{'no_open': True,'no_create': True}"/>
                                    <field name="description"/>
                                    <field name="uom_qty" string="Qty"
                                           force_save="1"/>
                                    <field name="uom_id"
                                           string="Unit of Measure"
                                           options="{'no_open': True,'no_create': True}"/>
                                    <field name="price_unit"/>
                                    <field name="tax_ids"
                                           options="{'no_create': True}"
                                           widget="many2many_tags"/>
                                    <field name="price_subtotal"
                                           widget="monetary"/>
                                    <field groups="account.group_account_manager"
                                           name="price_total"
                                           widget="monetary"/>
                                </list>
                            </field>
                            <group colspan="2"
                                   class="oe_subtotal_footer oe_right">
                                <field name="amount_untaxed_service"
                                       sum="Untaxed amount for Service"
                                       widget="monetary"/>
                                <field name="amount_taxed_service"
                                       widget="monetary"/>
                                <label for="amount_total_service"/>
                                <field name="amount_total_service" nolabel="1"
                                       sum="Total amount" widget="monetary"/>
                            </group>
                            <div class="oe_clear"/>
                        </page>
                        <page name="fleet" string="Fleet"
                              invisible="need_fleet == False">
                            <field name="vehicle_line_ids" colspan="4"
                                   string="Fleet Lines">
                                <list editable="bottom">
                                    <field name="fleet_id" string="Vehicle"
                                           required="1"
                                           options="{'no_open': True,'no_create': True}"/>
                                    <field name="description"/>
                                    <field name="uom_qty" string="Allotted KM"
                                           force_save="1"/>
                                    <field name="uom_id"
                                           string="Unit of Measure"
                                           options="{'no_open': True, 'no_create': True}"/>
                                    <field name="price_unit"/>
                                    <field name="tax_ids"
                                           options="{'no_create': True}"
                                           widget="many2many_tags"/>
                                    <field name="price_subtotal"
                                           widget="monetary"/>
                                    <field groups="account.group_account_manager"
                                           name="price_total"
                                           widget="monetary"/>
                                </list>
                            </field>
                            <group colspan="2"
                                   class="oe_subtotal_footer oe_right">
                                <field name="amount_untaxed_fleet"
                                       sum="Untaxed amount for Fleet"
                                       widget="monetary"/>
                                <field name="amount_taxed_fleet"
                                       widget="monetary"/>
                                <label for="amount_total_fleet"/>
                                <field name="amount_total_fleet" nolabel="1"
                                       sum="Total amount" widget="monetary"/>
                            </group>
                            <div class="oe_clear"/>
                        </page>
                        <page name="event" string="Events"
                              invisible=" need_event == False ">
                            <field name="event_line_ids" colspan="4"
                                   string="Event Lines">
                                <list editable="bottom">
                                    <field name="event_id" string="Event"
                                           required="1"
                                           options="{'no_open': True,'no_create': True}"/>
                                    <field name="description"/>
                                    <field name="ticket_id" string="Ticket"
                                           required="1"/>
                                    <field name="uom_qty" string="Qty"
                                           force_save="1"/>
                                    <field name="uom_id"
                                           string="Unit of Measure"
                                           options="{'no_open': True, 'no_create': True}"/>
                                    <field name="price_unit"/>
                                    <field name="tax_ids"
                                           options="{'no_create': True}"
                                           widget="many2many_tags"/>
                                    <field name="price_subtotal"
                                           widget="monetary"/>
                                    <field groups="account.group_account_manager"
                                           name="price_total"
                                           widget="monetary"/>
                                </list>
                            </field>
                            <group colspan="2"
                                   class="oe_subtotal_footer oe_right">
                                <field name="amount_untaxed_event"
                                       sum="Untaxed amount for Event"
                                       widget="monetary"/>
                                <field name="amount_taxed_event"
                                       widget="monetary"/>
                                <label for="amount_total_event"/>
                                <field name="amount_total_event" nolabel="1"
                                       sum="Total amount" widget="monetary"/>
                            </group>
                            <div class="oe_clear"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <!--     Room Booking Tree view -->
    <record id="room_booking_view_tree" model="ir.ui.view">
        <field name="name">room.booking.view.tree</field>
        <field name="model">room.booking</field>
        <field name="arch" type="xml">
            <list default_order="name desc" class="table-hover">
                <field name="is_special" column_invisible="True"/>
                <field name="folio_no" string="Folio Number" class="fw-bold text-dark text-center" optional="hide"/>
                <field name="room_name" string="Room No" class="fw-bold text-primary text-center" decoration-info="is_special"/>
                <field name="partner_id" string="Customer" class="fw-bold"/>
                <field name="stay_type" string="Category" widget="badge"
                       decoration-info="stay_type == 'lsr'"
                       decoration-danger="stay_type == 'prr'"
                       decoration-warning="stay_type == 'cr'"
                       decoration-success="stay_type == 'normal'"
                       class="text-center" optional="hide"/>
                <field name="date_order" string="Order Date" class="text-center" optional="hide"/>
                <field name="checkin_date" string="Check In" class="text-center" optional="show"/>
                <field name="checkout_date" string="Check Out" class="text-center" optional="show"/>
                <field name="amount_paid" string="Paid Revenue" widget="monetary" sum="Total Paid" class="text-end text-success fw-bold"/>
                <field name="room_rate" string="Rate" widget="monetary" sum="Total Rate" class="text-end text-primary fw-bold"/>
                <field name="today_balance" string="Today's Balance" widget="monetary" sum="Total Balance" decoration-bf="1" class="text-end"/>
                <field name="amount_total" string="Total Revenue" widget="monetary" sum="Grand Total" class="text-end fw-bold"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="state" string="Status" widget="badge"
                       decoration-info="is_special or state == 'draft'"
                       decoration-warning="not is_special and state == 'reserved'"
                       decoration-success="not is_special and state == 'check_in'"
                       decoration-muted="not is_special and state == 'check_out'"
                       class="text-center"/>
            </list>
        </field>
    </record>

    <!--     Room Booking Search View -->
    <record id="room_booking_view_search" model="ir.ui.view">
        <field name="name">room.booking.view.search</field>
        <field name="model">room.booking</field>
        <field name="arch" type="xml">
            <search string="Search Room Bookings">
                <field name="folio_no" string="Folio Number"/>
                <field name="name" string="Folio Reference"/>
                <field name="partner_id" string="Customer"/>
                <field name="room_name" string="Room No"/>
                <field name="stay_type" string="Category"/>
                <field name="meal_plan_id" string="Meal Plan"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <separator/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_reserved" string="Reserved" domain="[('state', '=', 'reserved')]"/>
                <filter name="filter_check_in" string="Checked In" domain="[('state', '=', 'check_in')]"/>
                <filter name="filter_check_out" string="Checked Out" domain="[('state', '=', 'check_out')]"/>
                <filter name="filter_done" string="Done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter name="filter_special" string="Special Rooms (Sea View)" domain="[('is_special', '=', True)]"/>
                <filter name="filter_lsr" string="Long Stay (LSR)" domain="[('is_long_stay', '=', True)]"/>
                <filter name="filter_prr" string="Reserved (RR)" domain="[('is_private_reserved', '=', True)]"/>
                <filter name="filter_cr" string="Complimentary (CR)" domain="[('is_cr', '=', True)]"/>
                <filter name="filter_nr" string="Normal (NR)" domain="[('is_long_stay', '=', False), ('is_private_reserved', '=', False), ('is_cr', '=', False)]"/>
                <separator/>
                <filter name="group_by_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                <filter name="group_by_stay_type" string="Stay Category" context="{'group_by': 'stay_type'}"/>
                <filter name="group_by_meal_plan" string="Meal Plan" context="{'group_by': 'meal_plan_id'}"/>
                <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_by_date" string="Order Date" context="{'group_by': 'date_order:month'}"/>
                <filter name="group_by_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
            </search>
        </field>
    </record>

    <!--     Room Booking Menu action -->
    <record id="room_booking_action" model="ir.actions.act_window">
        <field name="name">Room Booking</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">room.booking</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="room_booking_view_search"/>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Book your rooms here!
            </p>
        </field>
    </record>
    <!--     Reservation menu -->
    <menuitem id="room_booking_menu" name="Reservation" sequence="10"
              parent="hotel_management_menu_root"
              action="room_booking_action"/>
</odoo>
