<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Hotel Night Audit List View -->
    <record id="view_hotel_night_audit_tree" model="ir.ui.view">
        <field name="name">hotel.night.audit.list</field>
        <field name="model">hotel.night.audit</field>
        <field name="arch" type="xml">
            <list string="Night Audits" decoration-info="state == 'draft'" decoration-success="state == 'done'">
                <field name="date" string="Audit Date"/>
                <field name="name" string="Audit Reference"/>
                <field name="audit_type" widget="badge" decoration-info="audit_type == 'night'" decoration-warning="audit_type == 'day'"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="user_id" string="Audited / Printed By" widget="many2one_avatar_user"/>
                <field name="total_checkin_count" string="Check-Ins"/>
                <field name="total_checkout_count" string="Check-Outs"/>
                <field name="inhouse_count" string="In-House"/>
                <field name="daily_room_revenue" string="Room Rent" sum="Total Room Rent" widget="monetary"/>
                <field name="daily_pos_revenue" string="POS / Rest" sum="Total POS" widget="monetary"/>
                <field name="daily_total_revenue" string="Total Revenue" sum="Grand Total" widget="monetary"/>
                <field name="currency_id" invisible="1"/>
                <field name="state" string="Status" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <!-- Hotel Night Audit Form View -->
    <record id="view_hotel_night_audit_form" model="ir.ui.view">
        <field name="name">hotel.night.audit.form</field>
        <field name="model">hotel.night.audit</field>
        <field name="arch" type="xml">
            <form string="Night Audit">
                <header>
                    <button name="action_generate_audit" string="Generate / Run Audit" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_print_report" string="Print Audit Pack (PDF)" type="object" class="btn-success" icon="fa-print"/>
                    <button name="action_reset_draft" string="Re-Open / Edit" type="object" class="btn-secondary" invisible="state != 'done'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Audit Reference"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Audit Parameters">
                            <field name="date" readonly="state == 'done'"/>
                            <field name="audit_type" widget="radio" options="{'horizontal': true}" readonly="state == 'done'"/>
                        </group>
                        <group string="Audit Meta">
                            <field name="company_id" groups="base.group_multi_company" readonly="state == 'done'"/>
                            <field name="user_id" readonly="state == 'done'"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>

                    <group string="Daily Key Performance Indicators (KPIs)">
                        <group>
                            <field name="total_checkin_count"/>
                            <field name="total_checkout_count"/>
                            <field name="inhouse_count"/>
                        </group>
                        <group>
                            <field name="daily_room_revenue" widget="monetary"/>
                            <field name="daily_pos_revenue" widget="monetary"/>
                            <field name="daily_total_revenue" widget="monetary" class="oe_subtotal_footer_separator text-primary fw-bold fs-5"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Hotel Night Audit Search View -->
    <record id="view_hotel_night_audit_search" model="ir.ui.view">
        <field name="name">hotel.night.audit.search</field>
        <field name="model">hotel.night.audit</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="date"/>
                <field name="user_id"/>
                <filter string="Night Audits" name="filter_night" domain="[('audit_type', '=', 'night')]"/>
                <filter string="Day Audits" name="filter_day" domain="[('audit_type', '=', 'day')]"/>
                <filter string="Closed" name="filter_done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <group>
                    <filter string="Audit Type" name="group_by_type" context="{'group_by': 'audit_type'}"/>
                    <filter string="Date" name="group_by_date" context="{'group_by': 'date'}"/>
                    <filter string="Audited By" name="group_by_user" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Night Audit Action -->
    <record id="action_hotel_night_audit" model="ir.actions.act_window">
        <field name="name">Night Audit</field>
        <field name="res_model">hotel.night.audit</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a Daily Night Audit!
            </p>
            <p>
                Run daily night/day audits to generate consolidated operations and financial reports (Check-ins, Check-outs, In-House Guests, Daily Rent, POS Restaurant Sales, and Guest Ledger).
            </p>
        </field>
    </record>

    <!-- Top-level Menu in Hotel Management -->
    <menuitem id="menu_hotel_night_audit"
              name="Night Audit"
              parent="hotel_management_odoo.hotel_management_menu"
              action="action_hotel_night_audit"
              sequence="25"/>

    <!-- Reporting Submenu in Hotel Management > Reporting -->
    <menuitem id="menu_hotel_reporting_night_audit"
              name="Night Audit Reports"
              parent="hotel_management_odoo.reporting_menu"
              action="action_hotel_night_audit"
              sequence="1"/>
</odoo>
