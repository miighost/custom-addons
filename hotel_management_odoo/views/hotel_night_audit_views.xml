<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Hotel Night Audit Form View -->
    <record id="hotel_night_audit_view_form" model="ir.ui.view">
        <field name="name">hotel.night.audit.view.form</field>
        <field name="model">hotel.night.audit</field>
        <field name="arch" type="xml">
            <form string="Night Audit">
                <header>
                    <button name="action_print_pdf" string="Print Audit Pack (PDF)" type="object" class="btn-success" icon="fa-print"/>
                    <button name="action_print_excel" string="Export Excel (XLSX)" type="object" class="btn-secondary" icon="fa-download"/>
                    <button name="action_close_audit" string="Audit / Close" type="object" class="btn-primary" invisible="state == 'closed'"/>
                    <button name="action_reopen" string="Re-Open / Edit" type="object" class="btn-secondary" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,closed"/>
                </header>
                <sheet>
                    <div class="oe_title mb-4">
                        <span class="text-muted" style="font-size: 13px; text-transform: uppercase; letter-spacing: 1px;">Audit Reference</span>
                        <h1 class="mt-1" style="font-weight: 800; color: #111;">
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <group string="AUDIT DATE &amp; COMPANY">
                                <field name="date" readonly="state == 'closed'"/>
                                <field name="company_id" options="{'no_create': True, 'no_open': True}" readonly="state == 'closed'"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                        </div>
                        <div class="col-md-6">
                            <group string="AUDITOR &amp; SYSTEM">
                                <field name="user_id" options="{'no_create': True, 'no_open': True}" readonly="state == 'closed'"/>
                            </group>
                        </div>
                    </div>

                    <div class="mt-4">
                        <div style="border-bottom: 2px solid #ddd; padding-bottom: 5px; margin-bottom: 15px;">
                            <h6 style="font-weight: 800; letter-spacing: 0.5px; color: #333; text-transform: uppercase;">24-HOUR KEY PERFORMANCE INDICATORS (KPIS)</h6>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <group>
                                    <field name="check_ins_count" readonly="1"/>
                                    <field name="check_outs_count" readonly="1"/>
                                    <field name="in_house_guests_count" readonly="1"/>
                                </group>
                            </div>
                            <div class="col-md-6">
                                <group>
                                    <field name="daily_room_rent" widget="monetary" readonly="1"/>
                                    <field name="daily_pos_revenue" widget="monetary" readonly="1"/>
                                    <field name="total_day_revenue" widget="monetary" readonly="1" decoration-bf="1" style="font-size: 15px; font-weight: bold; color: #198754;"/>
                                </group>
                            </div>
                        </div>
                    </div>

                    <group string="AUDIT REMARKS / NOTES">
                        <field name="notes" placeholder="Optional audit notes or shift handover remarks..." nolabel="1" readonly="state == 'closed'"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Hotel Night Audit List View -->
    <record id="hotel_night_audit_view_tree" model="ir.ui.view">
        <field name="name">hotel.night.audit.view.tree</field>
        <field name="model">hotel.night.audit</field>
        <field name="arch" type="xml">
            <list string="Night Audit">
                <field name="date" string="Audit Date" decoration-success="1"/>
                <field name="name" string="Audit Reference" decoration-success="1" decoration-bf="1"/>
                <field name="company_id" string="Company"/>
                <field name="user_id" string="Audited / Printed By" widget="many2one_avatar_user"/>
                <field name="check_ins_count" string="Check-Ins" decoration-success="1"/>
                <field name="check_outs_count" string="Check-Outs"/>
                <field name="in_house_guests_count" string="In-House" decoration-success="1"/>
                <field name="daily_room_rent" widget="monetary" string="Room Rent" sum="Total Room Rent" decoration-success="1"/>
                <field name="daily_pos_revenue" widget="monetary" string="POS / Rest" sum="Total POS" decoration-success="1"/>
                <field name="total_day_revenue" widget="monetary" string="Total Revenue" sum="Total Revenue" decoration-success="1" decoration-bf="1"/>
                <field name="state" string="Status" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'closed'"/>
            </list>
        </field>
    </record>

    <!-- Hotel Night Audit Action -->
    <record id="hotel_night_audit_action" model="ir.actions.act_window">
        <field name="name">Night Audit</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hotel.night.audit</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new 24-Hour Night Audit!
            </p>
            <p>
                Select the audit date to automatically calculate key performance indicators (check-ins, check-outs, room rent, POS sales), and print the consolidated 5-in-1 audit pack.
            </p>
        </field>
    </record>
</odoo>
