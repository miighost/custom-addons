<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Hotel Room list view (Clean List View with Sea View Blue Status Highlight) -->
    <record id="hotel_room_view_tree" model="ir.ui.view">
        <field name="name">hotel.room.view.tree</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <list default_order="name asc" decoration-muted="not active" class="table-hover">
                <field name="currency_id" column_invisible="True"/>
                <field name="is_special" column_invisible="True"/>
                <field name="name" string="Room No / Name" class="fw-bold text-primary"/>
                <field name="room_type" string="Room Type" class="fw-bold"/>
                <field name="floor_id" string="Floor" class="text-center"/>
                <field name="num_person" string="Capacity (Pax)" class="text-center"/>
                <field name="list_price" string="Rent / Day" class="text-end fw-bold"/>
                <field name="income_account_id" string="Income Account" optional="hide"/>
                <field name="status" widget="badge"
                       decoration-info="is_special"
                       decoration-success="not is_special and status == 'available'"
                       decoration-warning="not is_special and status == 'reserved'"
                       decoration-danger="not is_special and status == 'occupied'"
                       class="text-center fw-bold"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- Hotel Room form view with Special Room Toggle -->
    <record id="hotel_room_view_form" model="ir.ui.view">
        <field name="name">hotel.room.view.form</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <form string="Hotel Room">
                <header>
                    <field name="status" widget="statusbar" readonly="1"/>
                </header>
                <sheet>
                    <field name="room_image" widget="image"
                           class="oe_avatar"
                           options="{'preview_image': 'room_image'}"/>
                    <div class="oe_title">
                        <label for="name" string="Name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                        <h2>
                            <field name="is_room_avail" invisible="1"/>
                        </h2>
                    </div>
                    <notebook>
                        <page name="information_hotel_room"
                              string="Information">
                            <group>
                                <group>
                                    <field name="floor_id" string="Floor"/>
                                    <field name="is_special" string="Special Room (Sea View)" widget="boolean_toggle"/>
                                    <field name="user_id" string="Room Manager"/>
                                    <field name="taxes_ids"
                                           widget="many2many_tags"
                                           string="Customer Taxes"/>
                                </group>
                                <group>
                                    <field name="room_type"/>
                                    <field name="list_price"
                                           string="Rent"/>
                                    <field name="num_person"/>
                                    <field name="uom_id" invisible="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Amenities">
                            <group>
                                <field name="room_amenities_ids"
                                       widget="many2many_tags"
                                       string="Room Amenities"/>
                            </group>
                        </page>
                        <page string="Descriptions">
                            <separator string="Description"/>
                            <field name="description" colspan="4" nolabel="1"/>
                        </page>
                        <page string="Accounting" name="accounting">
                            <group>
                                <group string="Receivables &amp; Revenue">
                                    <field name="income_account_id"
                                           options="{'no_create': True}"/>
                                    <field name="taxes_ids"
                                           widget="many2many_tags"
                                           string="Customer Taxes"/>
                                </group>
                                <group string="Expenses &amp; Classification">
                                    <field name="expense_account_id"
                                           options="{'no_create': True}"/>
                                    <field name="categ_id"
                                           options="{'no_create_edit': True}"
                                           string="Room Category"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Hotel Room action -->
    <record id="hotel_room_action" model="ir.actions.act_window">
        <field name="name">Rooms</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hotel.room</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_is_room_avail': True}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                No Rooms found! Let's create one.
            </p>
        </field>
    </record>

    <!-- Direct Rooms Menu on Main Navbar -->
    <menuitem id="hotel_room_main_menu"
              name="Rooms"
              action="hotel_room_action"
              parent="hotel_management_menu_root"
              sequence="15"/>

    <!-- Room Menu under Configuration -->
    <menuitem id="hotel_room_menu"
              name="Room"
              action="hotel_room_action"
              parent="hotel_config_menu"
              sequence="20"/>
</odoo>
