<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Report Action for Night Audit Pack -->
    <record id="action_report_night_audit" model="ir.actions.report">
        <field name="name">Daily Night Audit Pack</field>
        <field name="model">night.audit.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hotel_management_odoo.report_night_audit</field>
        <field name="report_file">hotel_management_odoo.report_night_audit</field>
        <field name="binding_type">report</field>
    </record>

    <!-- QWeb PDF Template for Night Audit Pack -->
    <template id="report_night_audit">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #222;">
                    
                    <!-- ========================================================= -->
                    <!-- PAGE 1: EXECUTIVE COVER / TITLE PAGE                      -->
                    <!-- ========================================================= -->
                    <div style="min-height: 880px; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; padding-top: 120px;">
                        
                        <div style="margin-bottom: 50px;">
                            <h1 style="font-size: 42px; font-weight: 900; letter-spacing: 16px; color: #111; margin-bottom: 20px; text-transform: uppercase;">
                                N I G H T
                            </h1>
                            <h1 style="font-size: 42px; font-weight: 900; letter-spacing: 16px; color: #111; margin-bottom: 25px; text-transform: uppercase;">
                                A U D I T
                            </h1>
                            <div style="width: 200px; height: 3px; background-color: #333; margin: 0 auto 40px auto;"></div>
                        </div>

                        <div style="margin-bottom: 35px;">
                            <p style="font-size: 14px; letter-spacing: 4px; font-weight: 700; color: #777; margin-bottom: 6px; text-transform: uppercase;">
                                O N
                            </p>
                            <h3 style="font-size: 22px; font-weight: 800; color: #000; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 0;">
                                <t t-esc="cover.get('audit_date_formatted', '-')"/>
                            </h3>
                        </div>

                        <div style="margin-bottom: 40px;">
                            <p style="font-size: 14px; letter-spacing: 4px; font-weight: 700; color: #777; margin-bottom: 6px; text-transform: uppercase;">
                                B Y
                            </p>
                            <h4 style="font-size: 18px; font-weight: 700; color: #111; letter-spacing: 1px; text-transform: uppercase; margin-bottom: 0;">
                                <t t-esc="cover.get('audited_by', '-')"/>
                            </h4>
                        </div>

                        <t t-if="cover.get('notes')">
                            <div style="margin-top: 30px; width: 80%; max-width: 550px; padding: 12px 18px; border: 1px dashed #aaa; background-color: #fafafa; border-radius: 6px; font-size: 12px; text-align: left;">
                                <strong>Audit Remarks:</strong> <span t-esc="cover.get('notes')"/>
                            </div>
                        </t>

                        <div style="margin-top: 60px; font-size: 11px; color: #888; letter-spacing: 1px;">
                            24-HOUR CONSOLIDATED OPERATIONAL &amp; FINANCIAL AUDIT REPORT
                        </div>
                    </div>

                    <!-- ========================================================= -->
                    <!-- PAGE 2: ROOM ANALYSIS & 24-HR PERFORMANCE KPIS            -->
                    <!-- ========================================================= -->
                    <p style="page-break-before: always;"/>
                    <div style="padding-top: 15px;">
                        <div class="text-center mb-3">
                            <h3 style="font-weight: bold; color: #111; margin-bottom: 4px; text-transform: uppercase;">1. Room Analysis &amp; 24-Hr Performance KPIs</h3>
                            <p style="font-size: 12px; color: #555;">Audit Date: <strong style="color: #000;" t-esc="cover.get('audit_date', '-')"/></p>
                        </div>

                        <div class="row mb-3">
                            <!-- Left: Room Inventory -->
                            <div class="col-6">
                                <div style="border: 1px solid #777; border-radius: 6px; overflow: hidden; background-color: #fff;">
                                    <div style="background-color: #2c3e50; color: #fff; padding: 6px 10px; font-weight: bold; font-size: 11px;">
                                        ROOM OCCUPANCY &amp; INVENTORY
                                    </div>
                                    <table style="width: 100%; border-collapse: collapse; font-size: 11px;">
                                        <tr style="border-bottom: 1px solid #eee;">
                                            <td style="padding: 5px 10px; font-weight: 600;">Total Hotel Rooms</td>
                                            <td style="padding: 5px 10px; text-align: right; font-weight: bold;"><t t-esc="kpis.get('total_rooms', 0)"/></td>
                                        </tr>
                                        <tr style="border-bottom: 1px solid #eee;">
                                            <td style="padding: 5px 10px; font-weight: 600;">Available Rooms</td>
                                            <td style="padding: 5px 10px; text-align: right;"><t t-esc="kpis.get('available_rooms', 0)"/></td>
                                        </tr>
                                        <tr style="border-bottom: 1px solid #eee; background-color: #f8f9fa;">
                                            <td style="padding: 5px 10px; font-weight: 700; color: #0056b3;">Occupied Rooms</td>
                                            <td style="padding: 5px 10px; text-align: right; font-weight: 700; color: #0056b3;"><t t-esc="kpis.get('occupied_rooms', 0)"/></td>
                                        </tr>
                                        <tr style="border-bottom: 1px solid #eee;">
                                            <td style="padding: 5px 10px; font-weight: 600;">Vacant Rooms</td>
                                            <td style="padding: 5px 10px; text-align: right;"><t t-esc="kpis.get('vacant_rooms', 0)"/></td>
                                        </tr>
                                        <tr style="border-bottom: 1px solid #eee;">
                                            <td style="padding: 5px 10px; font-weight: 600;">Under Maintenance / Repair</td>
                                            <td style="padding: 5px 10px; text-align: right;"><t t-esc="kpis.get('maintenance_rooms', 0)"/></td>
                                        </tr>
                                        <tr style="border-bottom: 1px solid #eee;">
                                            <td style="padding: 5px 10px; font-weight: 600;">House Use / Cleaning</td>
                                            <td style="padding: 5px 10px; text-align: right;"><t t-esc="kpis.get('house_use_cleaning', 0)"/></td>
                                        </tr>
                                        <tr style="border-bottom: 1px solid #eee; background-color: #e8f4fd;">
                                            <td style="padding: 6px 10px; font-weight: 700;">Occupancy Rate (%)</td>
                                            <td style="padding: 6px 10px; text-align: right; font-weight: 800; font-size: 13px; color: #0b5ed7;"><t t-esc="kpis.get('occupancy_rate', '0%')"/></td>
                                        </tr>
                                        <tr style="border-bottom: 1px solid #eee;">
                                            <td style="padding: 5px 10px; font-weight: 600;">Arrivals (Check-Ins Today)</td>
                                            <td style="padding: 5px 10px; text-align: right;"><t t-esc="kpis.get('arrivals', 0)"/></td>
                                        </tr>
                                        <tr>
                                            <td style="padding: 5px 10px; font-weight: 600;">Departures (Check-Outs Today)</td>
                                            <td style="padding: 5px 10px; text-align: right;"><t t-esc="kpis.get('departures', 0)"/></td>
                                        </tr>
                                    </table>
                                </div>
                            </div>

                            <!-- Right: Financial Metrics -->
                            <div class="col-6">
                                <div style="border: 1px solid #777; border-radius: 6px; overflow: hidden; background-color: #fff;">
                                    <div style="background-color: #2c3e50; color: #fff; padding: 6px 10px; font-weight: bold; font-size: 11px;">
                                        FINANCIAL PERFORMANCE (24-HR)
                                    </div>
                                    <table style="width: 100%; border-collapse: collapse; font-size: 11px;">
                                        <tr style="border-bottom: 1px solid #eee;">
                                            <td style="padding: 5px 10px; font-weight: 600;">Total Room Rent</td>
                                            <td style="padding: 5px 10px; text-align: right; font-weight: bold;"><t t-esc="kpis.get('total_room_rent', '0.00')"/></td>
                                        </tr>
                                        <tr style="border-bottom: 1px solid #eee;">
                                            <td style="padding: 5px 10px; font-weight: 600;">Total Restaurant &amp; POS</td>
                                            <td style="padding: 5px 10px; text-align: right;"><t t-esc="kpis.get('total_restaurant_pos', '0.00')"/></td>
                                        </tr>
                                        <tr style="border-bottom: 1px solid #eee; background-color: #eafaf1;">
                                            <td style="padding: 6px 10px; font-weight: 700; color: #198754;">Grand Total Daily Revenue</td>
                                            <td style="padding: 6px 10px; text-align: right; font-weight: 800; font-size: 13px; color: #198754;"><t t-esc="kpis.get('grand_total_revenue', '0.00')"/></td>
                                        </tr>
                                        <tr style="border-bottom: 1px solid #eee;">
                                            <td style="padding: 5px 10px; font-weight: 600;">ARR (Average Room Rate)</td>
                                            <td style="padding: 5px 10px; text-align: right; font-weight: 700;"><t t-esc="kpis.get('arr', '0.00')"/></td>
                                        </tr>
                                        <tr style="border-bottom: 1px solid #eee;">
                                            <td style="padding: 5px 10px; font-weight: 600;">RevPAR (Rev per Avail Room)</td>
                                            <td style="padding: 5px 10px; text-align: right; font-weight: 700;"><t t-esc="kpis.get('revpar', '0.00')"/></td>
                                        </tr>
                                        <tr style="border-bottom: 1px solid #eee;">
                                            <td style="padding: 5px 10px; font-weight: 600;">In-House Guests (Pax)</td>
                                            <td style="padding: 5px 10px; text-align: right;"><t t-esc="kpis.get('inhouse_pax', 0)"/></td>
                                        </tr>
                                        <tr>
                                            <td style="padding: 5px 10px; font-weight: 600;">Average Guest Rate (AGR)</td>
                                            <td style="padding: 5px 10px; text-align: right; font-weight: 700;"><t t-esc="kpis.get('agr', '0.00')"/></td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ========================================================= -->
                    <!-- PAGE 3: IN-HOUSE GUEST LIST                               -->
                    <!-- ========================================================= -->
                    <p style="page-break-before: always;"/>
                    <div style="padding-top: 15px;">
                        <div class="text-center mb-3">
                            <h3 style="font-weight: bold; color: #111; margin-bottom: 4px; text-transform: uppercase;">2. In-House Guest List</h3>
                            <p style="font-size: 12px; color: #555;">Total In-House Bookings: <strong style="color: #000;" t-esc="len(inhouse_list)"/></p>
                        </div>
                        <table class="table table-sm table-bordered" style="width: 100%; border-collapse: collapse; font-size: 10px;">
                            <thead>
                                <tr style="background-color: #f2f2f2; text-align: center; font-weight: bold; color: #111;">
                                    <th style="border: 1px solid #555; padding: 5px 2px; width: 4%;">SN</th>
                                    <th style="border: 1px solid #555; padding: 5px 4px; width: 18%;">Guest Name</th>
                                    <th style="border: 1px solid #555; padding: 5px 3px; width: 9%;">Room No</th>
                                    <th style="border: 1px solid #555; padding: 5px 3px; width: 9%;">Check In</th>
                                    <th style="border: 1px solid #555; padding: 5px 3px; width: 9%;">Dep Date</th>
                                    <th style="border: 1px solid #555; padding: 5px 3px; width: 12%;">Pricelist</th>
                                    <th style="border: 1px solid #555; padding: 5px 3px; width: 13%;">Nationality</th>
                                    <th style="border: 1px solid #555; padding: 5px 3px; width: 14%;">City Ledger</th>
                                    <th style="border: 1px solid #555; padding: 5px 3px; width: 12%; text-align: right;">Room Rate</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="inhouse_list">
                                    <t t-foreach="inhouse_list" t-as="ih">
                                        <tr>
                                            <td class="text-center" style="border: 1px solid #666; padding: 4px 2px;"><t t-esc="ih['s_no']"/></td>
                                            <td style="border: 1px solid #666; padding: 4px;"><t t-esc="ih['guest_name']"/></td>
                                            <td class="text-center" style="border: 1px solid #666; padding: 4px;"><t t-esc="ih['room_no']"/></td>
                                            <td class="text-center" style="border: 1px solid #666; padding: 4px;"><t t-esc="ih['checkin']"/></td>
                                            <td class="text-center" style="border: 1px solid #666; padding: 4px;"><t t-esc="ih['checkout']"/></td>
                                            <td style="border: 1px solid #666; padding: 4px;"><t t-esc="ih['pricelist']"/></td>
                                            <td style="border: 1px solid #666; padding: 4px;"><t t-esc="ih['nationality']"/></td>
                                            <td style="border: 1px solid #666; padding: 4px;"><t t-esc="ih['company']"/></td>
                                            <td class="text-right" style="border: 1px solid #666; padding: 4px; font-weight: bold;"><t t-esc="ih['room_rate']"/></td>
                                        </tr>
                                    </t>
                                </t>
                                <t t-else="">
                                    <tr>
                                        <td colspan="9" class="text-center" style="border: 1px solid #666; padding: 10px; color: #777;">No active in-house guests recorded.</td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>

                    <!-- ========================================================= -->
                    <!-- PAGE 4: CHECK-INS (ARRIVALS) & CHECK-OUTS (DEPARTURES)    -->
                    <!-- ========================================================= -->
                    <p style="page-break-before: always;"/>
                    <div style="padding-top: 15px;">
                        <div class="text-center mb-3">
                            <h3 style="font-weight: bold; color: #111; margin-bottom: 4px; text-transform: uppercase;">3. Daily Arrivals &amp; Departures Activity</h3>
                            <p style="font-size: 12px; color: #555;">Audit Date: <strong style="color: #000;" t-esc="cover.get('audit_date', '-')"/></p>
                        </div>

                        <!-- Arrivals Section -->
                        <h4 style="font-weight: bold; font-size: 11px; margin-bottom: 6px; color: #0056b3;">ARRIVALS (CHECK-INS TODAY)</h4>
                        <table class="table table-sm table-bordered mb-4" style="width: 100%; border-collapse: collapse; font-size: 10px;">
                            <thead>
                                <tr style="background-color: #f2f2f2; text-align: center; font-weight: bold; color: #111;">
                                    <th style="border: 1px solid #555; padding: 4px 2px; width: 5%;">S No</th>
                                    <th style="border: 1px solid #555; padding: 4px; width: 25%;">Guest Name</th>
                                    <th style="border: 1px solid #555; padding: 4px; width: 12%;">Room No</th>
                                    <th style="border: 1px solid #555; padding: 4px; width: 15%;">In Time</th>
                                    <th style="border: 1px solid #555; padding: 4px; width: 15%;">Expected Departure</th>
                                    <th style="border: 1px solid #555; padding: 4px; width: 15%;">Booking No</th>
                                    <th style="border: 1px solid #555; padding: 4px; width: 13%;">Plan</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="arrivals_list">
                                    <t t-foreach="arrivals_list" t-as="a">
                                        <tr>
                                            <td class="text-center" style="border: 1px solid #666; padding: 4px 2px;"><t t-esc="a['s_no']"/></td>
                                            <td style="border: 1px solid #666; padding: 4px;"><t t-esc="a['guest_name']"/></td>
                                            <td class="text-center" style="border: 1px solid #666; padding: 4px;"><t t-esc="a['room_no']"/></td>
                                            <td class="text-center" style="border: 1px solid #666; padding: 4px;"><t t-esc="a['in_time']"/></td>
                                            <td class="text-center" style="border: 1px solid #666; padding: 4px;"><t t-esc="a['out_date']"/></td>
                                            <td class="text-center" style="border: 1px solid #666; padding: 4px;"><t t-esc="a['booking_no']"/></td>
                                            <td class="text-center" style="border: 1px solid #666; padding: 4px;"><t t-esc="a['plan']"/></td>
                                        </tr>
                                    </t>
                                </t>
                                <t t-else="">
                                    <tr>
                                        <td colspan="7" class="text-center" style="border: 1px solid #666; padding: 8px; color: #777;">No check-ins recorded today.</td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Departures Section -->
                        <h4 style="font-weight: bold; font-size: 11px; margin-bottom: 6px; color: #dc3545;">DEPARTURES (CHECK-OUTS TODAY)</h4>
                        <table class="table table-sm table-bordered" style="width: 100%; border-collapse: collapse; font-size: 10px;">
                            <thead>
                                <tr style="background-color: #f2f2f2; text-align: center; font-weight: bold; color: #111;">
                                    <th style="border: 1px solid #555; padding: 4px 2px; width: 5%;">S No</th>
                                    <th style="border: 1px solid #555; padding: 4px; width: 24%;">Guest Name</th>
                                    <th style="border: 1px solid #555; padding: 4px; width: 10%;">Room No</th>
                                    <th style="border: 1px solid #555; padding: 4px; width: 14%;">Out Time</th>
                                    <th style="border: 1px solid #555; padding: 4px; width: 15%;">Invoice No</th>
                                    <th style="border: 1px solid #555; padding: 4px; width: 18%;">Company</th>
                                    <th style="border: 1px solid #555; padding: 4px; width: 14%; text-align: right;">Total Rate</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="departures_list">
                                    <t t-foreach="departures_list" t-as="d">
                                        <tr>
                                            <td class="text-center" style="border: 1px solid #666; padding: 4px 2px;"><t t-esc="d['s_no']"/></td>
                                            <td style="border: 1px solid #666; padding: 4px;"><t t-esc="d['guest_name']"/></td>
                                            <td class="text-center" style="border: 1px solid #666; padding: 4px;"><t t-esc="d['room_no']"/></td>
                                            <td class="text-center" style="border: 1px solid #666; padding: 4px;"><t t-esc="d['out_time']"/></td>
                                            <td class="text-center" style="border: 1px solid #666; padding: 4px;"><t t-esc="d['invoice_no']"/></td>
                                            <td style="border: 1px solid #666; padding: 4px;"><t t-esc="d['company']"/></td>
                                            <td class="text-right" style="border: 1px solid #666; padding: 4px; font-weight: bold;"><t t-esc="d['rate']"/></td>
                                        </tr>
                                    </t>
                                </t>
                                <t t-else="">
                                    <tr>
                                        <td colspan="7" class="text-center" style="border: 1px solid #666; padding: 8px; color: #777;">No check-outs recorded today.</td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>

                    <!-- ========================================================= -->
                    <!-- PAGE 5: DAILY ACCRUED ROOM CHARGES                        -->
                    <!-- ========================================================= -->
                    <p style="page-break-before: always;"/>
                    <div style="padding-top: 15px;">
                        <div class="text-center mb-3">
                            <h3 style="font-weight: bold; color: #111; margin-bottom: 4px; text-transform: uppercase;">4. Daily Accrued Room Charges</h3>
                            <p style="font-size: 12px; color: #555;">Audit Date: <strong style="color: #000;" t-esc="cover.get('audit_date', '-')"/></p>
                        </div>
                        <table class="table table-sm table-bordered" style="width: 100%; border-collapse: collapse; font-size: 10px;">
                            <thead>
                                <tr style="background-color: #f2f2f2; text-align: center; font-weight: bold; color: #111;">
                                    <th style="border: 1px solid #555; padding: 5px 2px; width: 4%;">S No</th>
                                    <th style="border: 1px solid #555; padding: 5px 4px; width: 20%;">Name</th>
                                    <th style="border: 1px solid #555; padding: 5px 3px; width: 10%;">Room No</th>
                                    <th style="border: 1px solid #555; padding: 5px 3px; width: 12%;">Card No</th>
                                    <th style="border: 1px solid #555; padding: 5px 3px; width: 11%;">Check In</th>
                                    <th style="border: 1px solid #555; padding: 5px 2px; width: 6%;">Pax</th>
                                    <th style="border: 1px solid #555; padding: 5px 4px; width: 22%;">Company Name</th>
                                    <th style="border: 1px solid #555; padding: 5px 3px; width: 15%; text-align: right;">Daily Rent</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="daily_rent_list">
                                    <t t-foreach="daily_rent_list" t-as="r">
                                        <tr>
                                            <td class="text-center" style="border: 1px solid #666; padding: 4px 2px;"><t t-esc="r['s_no']"/></td>
                                            <td style="border: 1px solid #666; padding: 4px;"><t t-esc="r['name']"/></td>
                                            <td class="text-center" style="border: 1px solid #666; padding: 4px;"><t t-esc="r['room_no']"/></td>
                                            <td class="text-center" style="border: 1px solid #666; padding: 4px;"><t t-esc="r['card_no']"/></td>
                                            <td class="text-center" style="border: 1px solid #666; padding: 4px;"><t t-esc="r['check_in']"/></td>
                                            <td class="text-center" style="border: 1px solid #666; padding: 4px;"><t t-esc="r['pax']"/></td>
                                            <td style="border: 1px solid #666; padding: 4px;"><t t-esc="r['company_name']"/></td>
                                            <td class="text-right" style="border: 1px solid #666; padding: 4px; font-weight: bold;"><t t-esc="r['rent']"/></td>
                                        </tr>
                                    </t>
                                </t>
                                <t t-else="">
                                    <tr>
                                        <td colspan="8" class="text-center" style="border: 1px solid #666; padding: 10px; color: #777;">No occupied rooms charged on this audit date.</td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr style="background-color: #eaeaea; font-weight: bold;">
                                    <td colspan="7" class="text-right" style="border: 1px solid #555; padding: 5px;">Total Daily Accrued Rent:</td>
                                    <td class="text-right" style="border: 1px solid #555; padding: 5px; font-size: 11px;"><t t-esc="kpis.get('total_room_rent', '0.00')"/></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <!-- ========================================================= -->
                    <!-- PAGE 6: CASH REPORT / POS & GUEST COLLECTIONS             -->
                    <!-- ========================================================= -->
                    <p style="page-break-before: always;"/>
                    <div style="padding-top: 15px;">
                        <div class="text-center mb-3">
                            <h3 style="font-weight: bold; color: #111; margin-bottom: 4px; text-transform: uppercase;">5. Cash Report &amp; POS Collections</h3>
                            <p style="font-size: 12px; color: #555;">Audit Date: <strong style="color: #000;" t-esc="cover.get('audit_date', '-')"/></p>
                        </div>

                        <!-- Summary of Collections by Payment Method -->
                        <t t-if="method_summary">
                            <div style="border: 1px solid #999; border-radius: 6px; padding: 8px 12px; margin-bottom: 14px; background-color: #fafafa;">
                                <div style="font-weight: bold; margin-bottom: 4px; color: #333; font-size: 11px;">COLLECTIONS SUMMARY BY PAYMENT METHOD:</div>
                                <div class="row" style="font-size: 10px;">
                                    <t t-foreach="method_summary" t-as="m">
                                        <div class="col-3" style="margin-bottom: 3px;">
                                            <strong style="color: #555;"><t t-esc="m['method']"/>:</strong> <span style="font-weight: bold; color: #000;" t-esc="m['total']"/>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </t>

                        <!-- Cash Transaction Table -->
                        <table class="table table-sm table-bordered" style="width: 100%; border-collapse: collapse; font-size: 9px;">
                            <thead>
                                <tr style="background-color: #f2f2f2; text-align: center; font-weight: bold; color: #111;">
                                    <th style="border: 1px solid #555; padding: 4px 2px; width: 4%;">S.No</th>
                                    <th style="border: 1px solid #555; padding: 4px 2px; width: 13%;">Date</th>
                                    <th style="border: 1px solid #555; padding: 4px 2px; width: 6%;">CAS</th>
                                    <th style="border: 1px solid #555; padding: 4px 2px; width: 14%;">Name</th>
                                    <th style="border: 1px solid #555; padding: 4px 2px; width: 12%;">Voucher No</th>
                                    <th style="border: 1px solid #555; padding: 4px 2px; width: 15%;">Remarks</th>
                                    <th style="border: 1px solid #555; padding: 4px 2px; width: 8%;">CardNo</th>
                                    <th style="border: 1px solid #555; padding: 4px 2px; width: 6%;">RoomNo</th>
                                    <th style="border: 1px solid #555; padding: 4px 2px; width: 7%; text-align: right;">Debit</th>
                                    <th style="border: 1px solid #555; padding: 4px 2px; width: 7%; text-align: right;">Credit</th>
                                    <th style="border: 1px solid #555; padding: 4px 2px; width: 8%; text-align: right;">Balance</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="cash_lines">
                                    <t t-foreach="cash_lines" t-as="cl">
                                        <tr>
                                            <td class="text-center" style="border: 1px solid #666; padding: 3px 2px;"><t t-esc="cl['s_no']"/></td>
                                            <td class="text-center" style="border: 1px solid #666; padding: 3px 2px;"><t t-esc="cl['date']"/></td>
                                            <td class="text-center" style="border: 1px solid #666; padding: 3px 2px; font-weight: bold;"><t t-esc="cl['cas']"/></td>
                                            <td style="border: 1px solid #666; padding: 3px 2px;"><t t-esc="cl['name']"/></td>
                                            <td class="text-center" style="border: 1px solid #666; padding: 3px 2px;"><t t-esc="cl['voucher_no']"/></td>
                                            <td style="border: 1px solid #666; padding: 3px 2px;"><t t-esc="cl['remarks']"/></td>
                                            <td class="text-center" style="border: 1px solid #666; padding: 3px 2px;"><t t-esc="cl['card_no']"/></td>
                                            <td class="text-center" style="border: 1px solid #666; padding: 3px 2px;"><t t-esc="cl['room_no']"/></td>
                                            <td class="text-right" style="border: 1px solid #666; padding: 3px 2px;"><t t-esc="cl['debit']"/></td>
                                            <td class="text-right" style="border: 1px solid #666; padding: 3px 2px; font-weight: bold; color: #198754;"><t t-esc="cl['credit']"/></td>
                                            <td class="text-right" style="border: 1px solid #666; padding: 3px 2px; font-weight: bold;"><t t-esc="cl['balance']"/></td>
                                        </tr>
                                    </t>
                                </t>
                                <t t-else="">
                                    <tr>
                                        <td colspan="11" class="text-center" style="border: 1px solid #666; padding: 8px; color: #777;">No cash or POS transactions recorded on this date.</td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr style="background-color: #eaeaea; font-weight: bold;">
                                    <td colspan="8" class="text-right" style="border: 1px solid #555; padding: 5px;">Total / Closing Balance:</td>
                                    <td class="text-right" style="border: 1px solid #555; padding: 5px;"><t t-esc="total_debit"/></td>
                                    <td class="text-right" style="border: 1px solid #555; padding: 5px; color: #198754;"><t t-esc="total_credit"/></td>
                                    <td class="text-right" style="border: 1px solid #555; padding: 5px; font-size: 10px;"><t t-esc="closing_balance"/></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                </div>
            </t>
        </t>
    </template>
</odoo>
