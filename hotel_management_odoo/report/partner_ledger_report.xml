<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Report Action for Customer Account Statement -->
    <record id="action_report_partner_ledger" model="ir.actions.report">
        <field name="name">Customer Account Statement</field>
        <field name="model">hotel.partner.ledger.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hotel_management_odoo.report_partner_ledger</field>
        <field name="report_file">hotel_management_odoo.report_partner_ledger</field>
        <field name="binding_type">report</field>
    </record>

    <!-- QWeb PDF Template for Customer Account Statement -->
    <template id="report_partner_ledger">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page" style="font-family: Arial, Helvetica, sans-serif; font-size: 13px; color: #000; margin-top: 10px;">
                    <t t-set="curr" t-value="currency or env.company.currency_id"/>
                    <t t-set="p_data" t-value="partner or {}"/>
                    <t t-set="stmt_lines" t-value="lines or []"/>
                    
                    <!-- Top Right Printed Date -->
                    <div class="row" style="margin-bottom: 12px;">
                        <div class="col-12 text-end text-right" style="font-size: 14px; font-weight: bold; color: #000;">
                            Print Date: <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d-%b-%Y %I:%M %p')"/>
                        </div>
                    </div>

                    <!-- Title (Centered, Bold) -->
                    <div class="row" style="margin-bottom: 20px;">
                        <div class="col-12 text-center">
                            <h2 style="font-weight: bold; color: #111; font-size: 24px; margin-bottom: 0;">Customer Account Statement</h2>
                        </div>
                    </div>

                    <!-- Header Information (2-Column Exact Layout) -->
                    <div class="row" style="margin-bottom: 20px; font-size: 14px; line-height: 1.9;">
                        <div class="col-6">
                            <table style="width: 100%; border-collapse: collapse;">
                                <tr>
                                    <td style="font-weight: bold; width: 120px;">Ref Number</td>
                                    <td style="font-weight: bold;"><t t-esc="p_data.get('ref', '-')"/></td>
                                </tr>
                                <tr>
                                    <td style="font-weight: bold;">Customer</td>
                                    <td style="font-weight: bold;"><t t-esc="p_data.get('name', '-')"/></td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-6">
                            <table style="width: 100%; border-collapse: collapse;">
                                <tr>
                                    <td style="font-weight: bold; text-align: right; width: 60%;">Statement Date</td>
                                    <td style="font-weight: bold; text-align: right; width: 40%;"><t t-esc="p_data.get('statement_date', '-')"/></td>
                                </tr>
                                <tr>
                                    <td style="text-align: right;">Opening Balance</td>
                                    <td style="text-align: right;"><t t-esc="opening_balance"/></td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <!-- Full-Width Transaction Table with Palette-Highlighted Header and Totals -->
                    <table class="table table-sm" style="width: 100%; font-size: 13px; border-collapse: collapse; margin-top: 10px;">
                        <thead>
                            <tr style="background-color: #2c3e50; color: #ffffff; text-align: center; font-weight: bold;">
                                <th style="border: 1px solid #2c3e50; color: #ffffff; text-align: left; padding: 7px 6px; width: 44%;">Description</th>
                                <th style="border: 1px solid #2c3e50; color: #ffffff; text-align: center; padding: 7px 4px; width: 16%;">Trans_Date</th>
                                <th style="border: 1px solid #2c3e50; color: #ffffff; text-align: right; padding: 7px 6px; width: 13%;">Debit</th>
                                <th style="border: 1px solid #2c3e50; color: #ffffff; text-align: right; padding: 7px 6px; width: 13%;">Credit</th>
                                <th style="border: 1px solid #2c3e50; color: #ffffff; text-align: right; padding: 7px 6px; width: 14%;">RTotal1</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="stmt_lines" t-as="l">
                                <tr style="border-bottom: 1px solid #e0e0e0; line-height: 1.5;">
                                    <td style="text-align: left; padding: 6px 6px; border-left: 1px solid #e0e0e0; border-right: 1px solid #e0e0e0; color: #212529;"><t t-esc="l.get('description', '-')"/></td>
                                    <td style="text-align: center; padding: 6px 4px; border-right: 1px solid #e0e0e0; color: #212529;"><t t-esc="l.get('trans_date', '-')"/></td>
                                    <td style="text-align: right; padding: 6px 6px; border-right: 1px solid #e0e0e0; color: #212529;"><t t-esc="l.get('debit', '0.00')"/></td>
                                    <td style="text-align: right; padding: 6px 6px; border-right: 1px solid #e0e0e0; color: #2e7d32;"><t t-esc="l.get('credit', '0.00')"/></td>
                                    <td style="text-align: right; padding: 6px 6px; border-right: 1px solid #e0e0e0; font-weight: bold; color: #212529;"><t t-esc="l.get('rtotal', '0.00')"/></td>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr style="background-color: #f8f9fa; font-weight: bold; font-size: 13px; border-top: 2px solid #2c3e50; border-bottom: 2px solid #2c3e50;">
                                <td colspan="2" style="border: 1px solid #ddd; padding: 8px 6px; text-align: left; font-weight: bold; color: #000;">Total / Closing Balance</td>
                                <td style="border: 1px solid #ddd; text-align: right; padding: 8px 6px; font-weight: bold; color: #000;"><t t-esc="total_period_debit"/></td>
                                <td style="border: 1px solid #ddd; text-align: right; padding: 8px 6px; font-weight: bold; color: #2e7d32;"><t t-esc="total_period_credit"/></td>
                                <td style="border: 1px solid #ddd; text-align: right; padding: 8px 6px; font-weight: bold; color: #c62828;"><t t-esc="ending_balance"/></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
