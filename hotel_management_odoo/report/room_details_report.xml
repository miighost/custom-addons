<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Report Action for Room Details Report -->
    <record id="action_report_room_details" model="ir.actions.report">
        <field name="name">Room Details Report</field>
        <field name="model">hotel.room</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hotel_management_odoo.report_room_details</field>
        <field name="report_file">hotel_management_odoo.report_room_details</field>
        <field name="binding_model_id" ref="model_hotel_room"/>
        <field name="binding_type">report</field>
    </record>

    <!-- QWeb PDF Template for Room Details Report -->
    <template id="report_room_details">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 13px; color: #111;">
                    <!-- Top Right Printed Date -->
                    <div class="row" style="margin-bottom: 8px;">
                        <div class="col-12 text-end text-right" style="font-size: 13px; color: #333;">
                            Print Date: <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d-%b-%Y %I:%M %p')"/>
                        </div>
                    </div>

                    <!-- Header Title -->
                    <div class="row mt8 mb16">
                        <div class="col-12 text-center">
                            <h2 style="font-weight: bold; color: #000; margin-bottom: 4px;">Room Details Report</h2>
                        </div>
                    </div>

                    <!-- Summary Stats (Clean Neutral Border) -->
                    <table class="table table-sm" style="width: 100%; border: 1px solid #000; margin-bottom: 20px; font-size: 12px; text-align: center; border-collapse: collapse;">
                        <tr style="background-color: #f9f9f9; font-weight: bold;">
                            <td style="border: 1px solid #000; padding: 6px;">Total Rooms: <t t-esc="total_rooms_count"/></td>
                            <td style="border: 1px solid #000; padding: 6px;">Available: <t t-esc="available_count"/></td>
                            <td style="border: 1px solid #000; padding: 6px;">Occupied: <t t-esc="occupied_count"/></td>
                            <td style="border: 1px solid #000; padding: 6px;">Reserved: <t t-esc="reserved_count"/></td>
                        </tr>
                    </table>

                    <!-- Categorized Room Tables -->
                    <t t-foreach="grouped_rooms" t-as="group">
                        <t t-set="group_name" t-value="group"/>
                        <t t-set="room_list" t-value="grouped_rooms[group]"/>

                        <!-- Clean Category Heading without dark banner colors -->
                        <div style="font-weight: bold; font-size: 14px; margin-top: 15px; margin-bottom: 6px; padding-bottom: 3px; border-bottom: 2px solid #000;">
                            <span t-esc="group_name"/>
                            <span style="font-size: 12px; font-weight: normal; float: right;">
                                Count: <t t-esc="len(room_list)"/> Rooms
                            </span>
                        </div>

                        <table class="table table-sm table-bordered" style="width: 100%; font-size: 12px; margin-bottom: 20px; border-collapse: collapse;">
                            <thead>
                                <tr style="background-color: #f2f2f2; text-align: center; font-weight: bold;">
                                    <th style="border: 1px solid #000; padding: 6px; width: 10%;">SN</th>
                                    <th style="border: 1px solid #000; padding: 6px; width: 45%; text-align: left;">Room No</th>
                                    <th style="border: 1px solid #000; padding: 6px; width: 20%;">No OF Bed</th>
                                    <th style="border: 1px solid #000; padding: 6px; width: 25%;">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="sn" t-value="0"/>
                                <t t-foreach="room_list" t-as="room">
                                    <t t-set="sn" t-value="sn + 1"/>
                                    <tr>
                                        <td class="text-center" style="border: 1px solid #000; padding: 6px;"><t t-esc="sn"/></td>
                                        <td style="border: 1px solid #000; padding: 6px; font-weight: bold;"><span t-field="room.name"/></td>
                                        <td class="text-center" style="border: 1px solid #000; padding: 6px;"><t t-esc="room.num_person"/> Bed<t t-if="room.num_person > 1">s</t></td>
                                        <td class="text-center" style="border: 1px solid #000; padding: 6px; font-weight: bold;">
                                            <t t-if="room.is_special">
                                                <span>Special (Sea View)</span>
                                            </t>
                                            <t t-elif="room.status == 'available'">
                                                <span>Available</span>
                                            </t>
                                            <t t-elif="room.status == 'occupied'">
                                                <span>Occupied</span>
                                            </t>
                                            <t t-elif="room.status == 'reserved'">
                                                <span>Reserved</span>
                                            </t>
                                            <t t-else="">
                                                <span t-field="room.status"/>
                                            </t>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>
                </div>
            </t>
        </t>
    </template>
</odoo>
