<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Report Action for Statement of Account -->
    <record id="action_report_statement_account" model="ir.actions.report">
        <field name="name">Statement of Account</field>
        <field name="model">statement.account.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hotel_management_odoo.report_statement_account</field>
        <field name="report_file">hotel_management_odoo.report_statement_account</field>
        <field name="binding_type">report</field>
    </record>

    <!-- QWeb PDF Template for Statement of Account -->
    <template id="report_statement_account">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page" style="font-family: Arial, sans-serif; font-size: 12px; color: #333;">
                    <t t-set="hdr" t-value="header or (stmt and stmt.get('header', {})) or {}"/>
                    <t t-set="sum_data" t-value="summary or (stmt and stmt.get('summary', {})) or {}"/>
                    <t t-set="stmt_lines" t-value="lines or (stmt and stmt.get('lines', [])) or []"/>
                    
                    <!-- Top Right Printed Date -->
                    <div class="row" style="margin-bottom: 8px;">
                        <div class="col-12 text-end text-right" style="font-size: 14px; font-weight: bold; color: #000;">
                            Print Date: <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d-%b-%Y %I:%M %p')"/>
                        </div>
                    </div>

                    <!-- Header Title -->
                    <div class="row mb16">
                        <div class="col-12 text-center">
                            <h2 style="font-weight: bold; color: #111; margin-bottom: 2px;">STATEMENT OF ACCOUNT</h2>
                            <p style="font-size: 12px; color: #555; margin-bottom: 12px;">Detailed Guest Folio &amp; Financial Ledger</p>
                        </div>
                    </div>

                    <!-- Top Info Card (Boxed Header) -->
                    <div style="border: 1px solid #999; border-radius: 8px; padding: 12px 16px; margin-bottom: 16px; background-color: #fafafa;">
                        <div class="row">
                            <!-- Left Details -->
                            <div class="col-6">
                                <table style="width: 100%; border-collapse: separate; border-spacing: 0 4px; font-size: 12px;">
                                    <tr>
                                        <td style="width: 110px; font-weight: bold; color: #444;">Card No</td>
                                        <td style="width: 15px;">:</td>
                                        <td><t t-esc="hdr.get('card_no', '-')"/></td>
                                    </tr>
                                    <tr>
                                        <td style="font-weight: bold; color: #444;">Guest No</td>
                                        <td>:</td>
                                        <td><t t-esc="hdr.get('guest_no', '-')"/></td>
                                    </tr>
                                    <tr>
                                        <td style="font-weight: bold; color: #444;">Name</td>
                                        <td>:</td>
                                        <td style="font-weight: bold;"><t t-esc="hdr.get('name', '-')"/></td>
                                    </tr>
                                    <tr>
                                        <td style="font-weight: bold; color: #444;">Nationality</td>
                                        <td>:</td>
                                        <td><t t-esc="hdr.get('nationality', '-')"/></td>
                                    </tr>
                                    <tr>
                                        <td style="font-weight: bold; color: #444;">Company</td>
                                        <td>:</td>
                                        <td><t t-esc="hdr.get('company', '-')"/></td>
                                    </tr>
                                </table>
                            </div>

                            <!-- Right Details -->
                            <div class="col-6">
                                <table style="width: 100%; border-collapse: separate; border-spacing: 0 4px; font-size: 12px;">
                                    <tr>
                                        <td style="width: 130px; font-weight: bold; color: #444;">Room No</td>
                                        <td style="width: 15px;">:</td>
                                        <td><t t-esc="hdr.get('room_no', '-')"/></td>
                                    </tr>
                                    <tr>
                                        <td style="font-weight: bold; color: #444;">No of Pax</td>
                                        <td>:</td>
                                        <td><t t-esc="hdr.get('pax', '1')"/></td>
                                    </tr>
                                    <tr>
                                        <td style="font-weight: bold; color: #444;">Arrival Date</td>
                                        <td>:</td>
                                        <td><t t-esc="hdr.get('arrival_date', '-')"/></td>
                                    </tr>
                                    <tr>
                                        <td style="font-weight: bold; color: #444;">Arrival Time</td>
                                        <td>:</td>
                                        <td><t t-esc="hdr.get('arrival_time', '-')"/></td>
                                    </tr>
                                    <tr>
                                        <td style="font-weight: bold; color: #111;">Balance Amount</td>
                                        <td>:</td>
                                        <td style="font-weight: bold; font-size: 14px; color: #000;"><t t-esc="hdr.get('balance_amount', '0.00')"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Statement Ledger Table -->
                    <table class="table table-sm" style="width: 100%; border-collapse: collapse; margin-bottom: 20px;">
                        <thead>
                            <tr style="background-color: #2c3e50; color: #fff; text-align: center; font-weight: bold; font-size: 11px;">
                                <th style="border: 1px solid #2c3e50; padding: 6px 4px; width: 6%;">S No</th>
                                <th style="border: 1px solid #2c3e50; padding: 6px 4px; width: 12%;">Date</th>
                                <th style="border: 1px solid #2c3e50; padding: 6px 8px; width: 34%; text-align: left;">Description</th>
                                <th style="border: 1px solid #2c3e50; padding: 6px 4px; width: 12%;">Room No</th>
                                <th style="border: 1px solid #2c3e50; padding: 6px 6px; width: 12%; text-align: right;">Debit</th>
                                <th style="border: 1px solid #2c3e50; padding: 6px 6px; width: 12%; text-align: right;">Credit</th>
                                <th style="border: 1px solid #2c3e50; padding: 6px 6px; width: 12%; text-align: right;">Balance</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="stmt_lines" t-as="l">
                                <tr style="border-bottom: 1px solid #e0e0e0; font-size: 11px;">
                                    <td style="text-align: center; padding: 5px 4px; border-left: 1px solid #ddd; border-right: 1px solid #ddd;"><t t-esc="l['s_no']"/></td>
                                    <td style="text-align: center; padding: 5px 4px; border-right: 1px solid #ddd;"><t t-esc="l['date']"/></td>
                                    <td style="text-align: left; padding: 5px 8px; border-right: 1px solid #ddd;"><t t-esc="l['description']"/></td>
                                    <td style="text-align: center; padding: 5px 4px; border-right: 1px solid #ddd;"><t t-esc="l['room_no']"/></td>
                                    <td style="text-align: right; padding: 5px 6px; border-right: 1px solid #ddd;"><t t-esc="l['debit']"/></td>
                                    <td style="text-align: right; padding: 5px 6px; border-right: 1px solid #ddd;"><t t-esc="l['credit']"/></td>
                                    <td style="text-align: right; padding: 5px 6px; border-right: 1px solid #ddd; font-weight: bold;"><t t-esc="l['balance']"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <!-- Summary Breakdown Cards (Bottom) -->
                    <div class="row mt16">
                        <!-- Left Summary: Category Breakdown -->
                        <div class="col-7">
                            <div style="border: 1px solid #777; border-radius: 6px; overflow: hidden; background-color: #fff;">
                                <div style="background-color: #4A6572; color: #fff; padding: 6px 10px; font-weight: bold; font-size: 11px;">
                                    CHARGES SUMMARY BREAKDOWN
                                </div>
                                <table style="width: 100%; border-collapse: collapse; font-size: 11px;">
                                    <tr style="border-bottom: 1px solid #eee;">
                                        <td style="padding: 4px 10px; font-weight: 600;">Total Room Accommodation</td>
                                        <td style="padding: 4px 10px; text-align: right; font-weight: bold;"><t t-esc="sum_data.get('total_room', '0.00')"/></td>
                                    </tr>
                                    <tr style="border-bottom: 1px solid #eee;">
                                        <td style="padding: 4px 10px; font-weight: 600;">Total Taxes &amp; VAT</td>
                                        <td style="padding: 4px 10px; text-align: right;"><t t-esc="sum_data.get('total_tax', '0.00')"/></td>
                                    </tr>
                                    <tr style="border-bottom: 1px solid #eee;">
                                        <td style="padding: 4px 10px; font-weight: 600;">Total Restaurant &amp; POS Orders</td>
                                        <td style="padding: 4px 10px; text-align: right;"><t t-esc="sum_data.get('total_restaurant', '0.00')"/></td>
                                    </tr>
                                    <tr style="border-bottom: 1px solid #eee;">
                                        <td style="padding: 4px 10px; font-weight: 600;">Total Hotel Services &amp; Laundry</td>
                                        <td style="padding: 4px 10px; text-align: right;"><t t-esc="sum_data.get('total_service', '0.00')"/></td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 4px 10px; font-weight: 600;">Total Vehicles &amp; Events</td>
                                        <td style="padding: 4px 10px; text-align: right;">
                                            <t t-set="other_chgs" t-value="float(sum_data.get('total_fleet', '0').replace(',', '')) + float(sum_data.get('total_event', '0').replace(',', ''))"/>
                                            <t t-esc="f'{other_chgs:,.2f}'"/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Right Summary: Statement Totals -->
                        <div class="col-5">
                            <div style="border: 1px solid #777; border-radius: 6px; overflow: hidden; background-color: #fff;">
                                <div style="background-color: #2c3e50; color: #fff; padding: 6px 10px; font-weight: bold; font-size: 11px;">
                                    STATEMENT TOTALS
                                </div>
                                <table style="width: 100%; border-collapse: collapse; font-size: 11px;">
                                    <tr style="border-bottom: 1px solid #eee;">
                                        <td style="padding: 5px 10px; font-weight: 600;">Total Charges (Debit)</td>
                                        <td style="padding: 5px 10px; text-align: right; font-weight: bold;"><t t-esc="sum_data.get('total_debit', '0.00')"/></td>
                                    </tr>
                                    <tr style="border-bottom: 1px solid #eee;">
                                        <td style="padding: 5px 10px; font-weight: 600;">Total Payments (Credit)</td>
                                        <td style="padding: 5px 10px; text-align: right; font-weight: bold; color: #2e7d32;"><t t-esc="sum_data.get('total_payments', '0.00')"/></td>
                                    </tr>
                                    <tr style="background-color: #f8f9fa;">
                                        <td style="padding: 6px 10px; font-weight: bold; font-size: 12px; color: #000;">NET BALANCE DUE</td>
                                        <td style="padding: 6px 10px; text-align: right; font-weight: bold; font-size: 13px; color: #c62828;"><t t-esc="sum_data.get('net_balance', '0.00')"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>

                </div>
            </t>
        </t>
    </template>
</odoo>
