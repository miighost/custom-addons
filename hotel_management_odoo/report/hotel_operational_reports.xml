<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Operational Reports Action -->
    <record id="action_report_hotel_operational" model="ir.actions.report">
        <field name="name">Hotel Operational Report</field>
        <field name="model">hotel.operational.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hotel_management_odoo.report_hotel_operational</field>
        <field name="report_file">hotel_management_odoo.report_hotel_operational</field>
        <field name="binding_type">report</field>
    </record>

    <!-- Operational Reports QWeb Template with external layout and matching tables -->
    <template id="report_hotel_operational">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <t t-set="rd" t-value="doc.get_report_data()"/>
                    <t t-set="rtype" t-value="doc.report_type"/>
                    <t t-set="currency" t-value="doc.company_id.currency_id"/>

                    <div class="page" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 11px; color: #212529;">
                        <style>
                            .table-custom { width: 100%; border-collapse: collapse; margin-top: 15px; margin-bottom: 20px; font-size: 10px; }
                            .table-custom th { background-color: #f1f3f5; color: #111; font-weight: bold; border: 1px solid #444; padding: 5px 6px; }
                            .table-custom td { border: 1px solid #777; padding: 4px 6px; }
                            .table-custom tr.total-row td { font-weight: bold; background-color: #f8f9fa; border-top: 2px solid #000; }
                            .text-right { text-align: right; }
                            .text-center { text-align: center; }
                            .report-banner { border: 1px solid #333; padding: 8px 12px; margin-bottom: 12px; background-color: #fafafa; }
                            .report-title-main { font-size: 18px; font-weight: bold; text-transform: uppercase; margin: 0; }
                            .date-badge { float: right; border: 1px solid #333; padding: 3px 10px; font-weight: bold; font-size: 11px; background: #fff; }
                        </style>

                        <!-- ================= 1. IN HOUSE GUEST LIST (IMAGE 1) ================= -->
                        <t t-if="rtype == 'inhouse'">
                            <div class="report-banner">
                                <div class="date-badge"><t t-esc="doc.date_from" t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/></div>
                                <h2 class="report-title-main">In House Guest List</h2>
                            </div>
                            <t t-if="rd['inhouse']">
                                <table class="table-custom">
                                    <thead>
                                        <tr>
                                            <th style="width: 7%;">Rm No</th>
                                            <th style="width: 22%;">Name</th>
                                            <th class="text-center" style="width: 4%;">Pax</th>
                                            <th class="text-center" style="width: 10%;">Check In</th>
                                            <th class="text-center" style="width: 10%;">Dep Date</th>
                                            <th class="text-center" style="width: 8%;">Plan</th>
                                            <th style="width: 10%;">Reg</th>
                                            <th style="width: 11%;">Nationality</th>
                                            <th style="width: 11%;">City Ledger</th>
                                            <th class="text-right" style="width: 7%;">Room Rate</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-set="total_rate" t-value="0.0"/>
                                        <t t-set="total_pax" t-value="0"/>
                                        <t t-foreach="rd['inhouse']" t-as="row">
                                            <t t-set="total_rate" t-value="total_rate + row['room_rate']"/>
                                            <t t-set="total_pax" t-value="total_pax + row['pax']"/>
                                            <tr>
                                                <td><strong><t t-esc="row['rm_no']"/></strong></td>
                                                <td><t t-esc="row['name']"/></td>
                                                <td class="text-center"><t t-esc="row['pax']"/></td>
                                                <td class="text-center"><t t-esc="row['checkin']"/></td>
                                                <td class="text-center"><t t-esc="row['checkout']"/></td>
                                                <td class="text-center"><t t-esc="row['plan']"/></td>
                                                <td><t t-esc="row['reg']"/></td>
                                                <td><t t-esc="row['nationality']"/></td>
                                                <td><t t-esc="row['city_ledger']"/></td>
                                                <td class="text-right"><t t-esc="'%.2f' % row['room_rate']"/></td>
                                            </tr>
                                        </t>
                                        <tr class="total-row">
                                            <td colspan="2"><strong>Total Occupied Rooms: <t t-esc="len(rd['inhouse'])"/></strong></td>
                                            <td class="text-center"><strong><t t-esc="total_pax"/></strong></td>
                                            <td colspan="6"></td>
                                            <td class="text-right"><strong><t t-esc="total_rate" t-options='{"widget": "monetary", "display_currency": doc.company_id.currency_id}'/></strong></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </t>
                            <t t-else="">
                                <p style="font-style: italic; color: #777;">No in-house guests found.</p>
                            </t>
                        </t>

                        <!-- ================= 2. ROOM ANALYSIS SUMMARY (IMAGE 2) ================= -->
                        <t t-if="rtype == 'room_analysis'">
                            <t t-set="ra" t-value="rd['room_analysis']"/>
                            <div class="report-banner">
                                <div class="date-badge"><t t-esc="doc.date_from" t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/></div>
                                <h2 class="report-title-main">Room Analysis Summary</h2>
                            </div>
                            <table class="table-custom" style="width: 75%; margin: 15px auto;">
                                <thead>
                                    <tr>
                                        <th style="width: 60%;">Metric / Indicator</th>
                                        <th class="text-right" style="width: 40%;">Performance</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td><strong>Occupied Rooms</strong></td>
                                        <td class="text-right"><t t-esc="ra['occupied']"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Vacant Rooms</strong></td>
                                        <td class="text-right"><t t-esc="ra['vacant']"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Under Repair / Maintenance</strong></td>
                                        <td class="text-right"><t t-esc="ra['repair']"/></td>
                                    </tr>
                                    <tr style="background-color: #f8f9fa; font-weight: bold;">
                                        <td><strong>Total Rooms</strong></td>
                                        <td class="text-right"><t t-esc="ra['total_rooms']"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>ARR (Average Room Rate)</strong></td>
                                        <td class="text-right"><t t-esc="'%.2f' % ra['arr']"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Guest In-House (Pax)</strong></td>
                                        <td class="text-right"><t t-esc="ra['guest_inhouse']"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>RevPAR (Revenue Per Available Room)</strong></td>
                                        <td class="text-right"><t t-esc="'%.2f' % ra['revpar']"/></td>
                                    </tr>
                                    <tr style="background-color: #e9ecef; font-weight: bold;">
                                        <td><strong>Occupancy Rate (%)</strong></td>
                                        <td class="text-right"><t t-esc="ra['occupancy_pct']"/> %</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Total Room Rent Revenue</strong></td>
                                        <td class="text-right"><t t-esc="'%.2f' % ra['room_revenue']"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Total Restaurant &amp; POS Revenue</strong></td>
                                        <td class="text-right"><t t-esc="'%.2f' % ra['pos_revenue']"/></td>
                                    </tr>
                                    <tr style="background-color: #d1e7dd; font-size: 12px; font-weight: bold;">
                                        <td><strong>Grand Total Revenue</strong></td>
                                        <td class="text-right"><t t-esc="'%.2f' % ra['total_revenue']"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>

                        <!-- ================= 3. CHECK IN REPORT ================= -->
                        <t t-if="rtype == 'checkin'">
                            <div class="report-banner">
                                <div class="date-badge">From <t t-esc="doc.date_from" t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/> To <t t-esc="doc.date_to" t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/></div>
                                <h2 class="report-title-main">Check In / Arrivals Report</h2>
                            </div>
                            <t t-if="rd['checkins']">
                                <table class="table-custom">
                                    <thead>
                                        <tr>
                                            <th class="text-center" style="width: 4%;">S No</th>
                                            <th style="width: 22%;">Guest Name</th>
                                            <th class="text-center" style="width: 7%;">Room</th>
                                            <th class="text-center" style="width: 4%;">Pax</th>
                                            <th style="width: 10%;">Card No</th>
                                            <th style="width: 15%;">Company</th>
                                            <th class="text-right" style="width: 8%;">Rate</th>
                                            <th class="text-center" style="width: 10%;">In Date</th>
                                            <th class="text-center" style="width: 8%;">In Time</th>
                                            <th class="text-center" style="width: 12%;">Plan</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-set="total_in_rate" t-value="0.0"/>
                                        <t t-foreach="rd['checkins']" t-as="row">
                                            <t t-set="total_in_rate" t-value="total_in_rate + row['rate']"/>
                                            <tr>
                                                <td class="text-center"><t t-esc="row['s_no']"/></td>
                                                <td><t t-esc="row['guest_name']"/></td>
                                                <td class="text-center"><strong><t t-esc="row['room']"/></strong></td>
                                                <td class="text-center"><t t-esc="row['pax']"/></td>
                                                <td><t t-esc="row['card_no']"/></td>
                                                <td><t t-esc="row['company']"/></td>
                                                <td class="text-right"><t t-esc="'%.2f' % row['rate']"/></td>
                                                <td class="text-center"><t t-esc="row['in_date']"/></td>
                                                <td class="text-center"><t t-esc="row['in_time']"/></td>
                                                <td class="text-center"><t t-esc="row['plan']"/></td>
                                            </tr>
                                        </t>
                                        <tr class="total-row">
                                            <td colspan="6"><strong>Total Arrivals: <t t-esc="len(rd['checkins'])"/></strong></td>
                                            <td class="text-right"><strong><t t-esc="'%.2f' % total_in_rate"/></strong></td>
                                            <td colspan="3"></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </t>
                            <t t-else="">
                                <p style="font-style: italic; color: #777;">No arrivals found for this period.</p>
                            </t>
                        </t>

                        <!-- ================= 4. CHECK OUT REPORT (IMAGE 3) ================= -->
                        <t t-if="rtype == 'checkout'">
                            <div class="report-banner">
                                <div class="date-badge">From <t t-esc="doc.date_from" t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/> To <t t-esc="doc.date_to" t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/></div>
                                <h2 class="report-title-main">Check Out Report</h2>
                            </div>
                            <t t-if="rd['checkouts']">
                                <table class="table-custom">
                                    <thead>
                                        <tr>
                                            <th class="text-center" style="width: 4%;">S No</th>
                                            <th style="width: 20%;">Guest Name</th>
                                            <th class="text-center" style="width: 7%;">Room No</th>
                                            <th class="text-center" style="width: 4%;">Pax</th>
                                            <th style="width: 9%;">Card No</th>
                                            <th style="width: 9%;">Invoice No</th>
                                            <th style="width: 14%;">Company</th>
                                            <th class="text-right" style="width: 7%;">Rate</th>
                                            <th class="text-center" style="width: 8%;">In Date</th>
                                            <th class="text-center" style="width: 6%;">In Time</th>
                                            <th class="text-center" style="width: 8%;">Out Date</th>
                                            <th class="text-center" style="width: 6%;">Out Time</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-set="total_out_rate" t-value="0.0"/>
                                        <t t-foreach="rd['checkouts']" t-as="row">
                                            <t t-set="total_out_rate" t-value="total_out_rate + row['rate']"/>
                                            <tr>
                                                <td class="text-center"><t t-esc="row['s_no']"/></td>
                                                <td><t t-esc="row['guest_name']"/></td>
                                                <td class="text-center"><strong><t t-esc="row['room_no']"/></strong></td>
                                                <td class="text-center"><t t-esc="row['pax']"/></td>
                                                <td><t t-esc="row['card_no']"/></td>
                                                <td><t t-esc="row['invoice_no']"/></td>
                                                <td><t t-esc="row['company']"/></td>
                                                <td class="text-right"><t t-esc="'%.2f' % row['rate']"/></td>
                                                <td class="text-center"><t t-esc="row['in_date']"/></td>
                                                <td class="text-center"><t t-esc="row['in_time']"/></td>
                                                <td class="text-center"><t t-esc="row['out_date']"/></td>
                                                <td class="text-center"><t t-esc="row['out_time']"/></td>
                                            </tr>
                                        </t>
                                        <tr class="total-row">
                                            <td colspan="7"><strong>Total Departures: <t t-esc="len(rd['checkouts'])"/></strong></td>
                                            <td class="text-right"><strong><t t-esc="'%.2f' % total_out_rate"/></strong></td>
                                            <td colspan="4"></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </t>
                            <t t-else="">
                                <p style="font-style: italic; color: #777;">No check-outs recorded for this period.</p>
                            </t>
                        </t>

                        <!-- ================= 5. DAILY RENT (IMAGE 4) ================= -->
                        <t t-if="rtype == 'daily_rent'">
                            <div class="report-banner">
                                <div class="date-badge">From <t t-esc="doc.date_from" t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/> To <t t-esc="doc.date_to" t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/></div>
                                <h2 class="report-title-main">Daily Rent</h2>
                                <div style="font-size: 10px; font-weight: bold; color: #555; margin-top: 2px;">ROOM CHARGES</div>
                            </div>
                            <t t-if="rd['daily_rent']">
                                <table class="table-custom">
                                    <thead>
                                        <tr>
                                            <th class="text-center" style="width: 5%;">S No</th>
                                            <th style="width: 25%;">Name</th>
                                            <th class="text-center" style="width: 9%;">Room No</th>
                                            <th style="width: 13%;">Card No</th>
                                            <th class="text-center" style="width: 12%;">Check In</th>
                                            <th class="text-center" style="width: 5%;">Pax</th>
                                            <th style="width: 20%;">Company Name</th>
                                            <th class="text-right" style="width: 11%;">Rent</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-set="total_rent" t-value="0.0"/>
                                        <t t-foreach="rd['daily_rent']" t-as="row">
                                            <t t-set="total_rent" t-value="total_rent + row['rent']"/>
                                            <tr>
                                                <td class="text-center"><t t-esc="row['s_no']"/></td>
                                                <td><t t-esc="row['name']"/></td>
                                                <td class="text-center"><strong><t t-esc="row['room_no']"/></strong></td>
                                                <td><t t-esc="row['card_no']"/></td>
                                                <td class="text-center"><t t-esc="row['checkin']"/></td>
                                                <td class="text-center"><t t-esc="row['pax']"/></td>
                                                <td><t t-esc="row['company_name']"/></td>
                                                <td class="text-right"><t t-esc="'%.2f' % row['rent']"/></td>
                                            </tr>
                                        </t>
                                        <tr class="total-row">
                                            <td colspan="5"><strong>Total Records: <t t-esc="len(rd['daily_rent'])"/></strong></td>
                                            <td colspan="2"></td>
                                            <td class="text-right"><strong><t t-esc="'%.2f' % total_rent"/></strong></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </t>
                        </t>

                        <!-- ================= 6. CASH & COLLECTIONS (IMAGE 5) ================= -->
                        <t t-if="rtype == 'cash_report'">
                            <div class="report-banner">
                                <div class="date-badge">From <t t-esc="doc.date_from" t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/> To <t t-esc="doc.date_to" t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/></div>
                                <h2 class="report-title-main">Cash Report</h2>
                                <div style="font-size: 10px; color: #666; margin-top: 2px;">Daily Collections &amp; Restaurant Transactions</div>
                            </div>
                            <t t-if="rd['cash_report']">
                                <table class="table-custom">
                                    <thead>
                                        <tr>
                                            <th class="text-center" style="width: 4%;">S.No</th>
                                            <th style="width: 12%;">Date</th>
                                            <th class="text-center" style="width: 6%;">CAS</th>
                                            <th style="width: 18%;">Name</th>
                                            <th style="width: 10%;">Voucher No</th>
                                            <th style="width: 16%;">Remarks</th>
                                            <th style="width: 8%;">CardNo</th>
                                            <th class="text-center" style="width: 6%;">RoomNo</th>
                                            <th class="text-right" style="width: 7%;">Debit</th>
                                            <th class="text-right" style="width: 6%;">Credit</th>
                                            <th class="text-right" style="width: 7%;">Balance</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-set="total_debit" t-value="0.0"/>
                                        <t t-foreach="rd['cash_report']" t-as="row">
                                            <t t-set="total_debit" t-value="total_debit + row['debit']"/>
                                            <tr>
                                                <td class="text-center"><t t-esc="row['s_no']"/></td>
                                                <td><t t-esc="row['date_time']"/></td>
                                                <td class="text-center"><t t-esc="row['method']"/></td>
                                                <td><t t-esc="row['name']"/></td>
                                                <td><t t-esc="row['voucher_no']"/></td>
                                                <td><t t-esc="row['remarks']"/></td>
                                                <td><t t-esc="row['card_no']"/></td>
                                                <td class="text-center"><t t-esc="row['room_no']"/></td>
                                                <td class="text-right"><t t-esc="'%.2f' % row['debit']"/></td>
                                                <td class="text-right"><t t-esc="'%.2f' % row['credit']"/></td>
                                                <td class="text-right"><t t-esc="'%.2f' % row['balance']"/></td>
                                            </tr>
                                        </t>
                                        <tr class="total-row">
                                            <td colspan="8"><strong>Total Collections: <t t-esc="len(rd['cash_report'])"/></strong></td>
                                            <td class="text-right"><strong><t t-esc="'%.2f' % total_debit"/></strong></td>
                                            <td></td>
                                            <td class="text-right"><strong><t t-esc="'%.2f' % total_debit"/></strong></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </t>
                        </t>

                        <!-- ================= 7. GUEST LEDGER ================= -->
                        <t t-if="rtype == 'guest_ledger'">
                            <div class="report-banner">
                                <div class="date-badge">As of <t t-esc="doc.date_to" t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/></div>
                                <h2 class="report-title-main">Guest Ledger &amp; Open Balances</h2>
                            </div>
                            <t t-if="rd['guest_ledger']">
                                <table class="table-custom">
                                    <thead>
                                        <tr>
                                            <th class="text-center" style="width: 4%;">S No</th>
                                            <th style="width: 14%;">Folio / Booking</th>
                                            <th class="text-center" style="width: 7%;">Room</th>
                                            <th style="width: 20%;">Guest Name</th>
                                            <th style="width: 15%;">Company / Ledger</th>
                                            <th class="text-center" style="width: 10%;">Check-In</th>
                                            <th class="text-center" style="width: 10%;">Check-Out</th>
                                            <th class="text-right" style="width: 10%;">Room Total</th>
                                            <th class="text-right" style="width: 10%;">POS Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="rd['guest_ledger']" t-as="row">
                                            <tr>
                                                <td class="text-center"><t t-esc="row['s_no']"/></td>
                                                <td><strong><t t-esc="row['booking_no']"/></strong></td>
                                                <td class="text-center"><t t-esc="row['room']"/></td>
                                                <td><t t-esc="row['guest_name']"/></td>
                                                <td><t t-esc="row['company']"/></td>
                                                <td class="text-center"><t t-esc="row['checkin']"/></td>
                                                <td class="text-center"><t t-esc="row['checkout']"/></td>
                                                <td class="text-right"><t t-esc="'%.2f' % row['room_charges']"/></td>
                                                <td class="text-right"><t t-esc="'%.2f' % row['pos_charges']"/></td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </t>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
