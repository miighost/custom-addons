<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Daily Room Charges Wizard Form View -->
    <record id="daily_room_charges_wizard_view_form" model="ir.ui.view">
        <field name="name">daily.room.charges.wizard.view.form</field>
        <field name="model">daily.room.charges.wizard</field>
        <field name="arch" type="xml">
            <form string="Daily Rent / Room Charges">
                <group>
                    <group>
                        <field name="date"/>
                    </group>
                    <group>
                        <field name="partner_id" options="{'no_create': True, 'no_open': True}"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_pdf" string="Download PDF" type="object" class="btn-primary" icon="fa-download"/>
                    <button name="action_print_excel" string="Download XLS" type="object" class="btn-primary" icon="fa-download"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Daily Room Charges Wizard Action -->
    <record id="daily_room_charges_wizard_action" model="ir.actions.act_window">
        <field name="name">Daily Rent / Room Charges</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">daily.room.charges.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
